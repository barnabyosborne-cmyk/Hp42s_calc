(footprint "Frontlight_SliverLand"
	(version 20221018)
	(generator "hand")
	(layer "F.Cu")
	(descr "Main-board land that a frontlight sliver castellation solders down onto. Origin matches hp42s:Frontlight_Castellation: it is where the sliver's end edge lands, with the sliver's body at +y. The pad runs 1.5 mm under the sliver and 2.5 mm out past it, so there is exposed copper to put an iron on. NO PASTE APERTURE ON PURPOSE -- a reflowed solder bump here would lift the sliver, and the LED height has about 0.1 mm of optical budget.")
	(tags "land board-to-board castellation frontlight sliver")
	(attr smd)
	(fp_text reference "REF**" (at 0 -3.40) (layer "F.SilkS") (effects (font (size 1 1) (thickness 0.15))))
	(fp_text value "Frontlight_SliverLand" (at 0 3.20) (layer "F.Fab") (effects (font (size 1 1) (thickness 0.15))))
	(fp_line (start -1.800 0) (end 1.800 0) (stroke (width 0.05) (type dot)) (layer "F.Fab"))
	(fp_text user "sliver edge" (at 0 1.00) (layer "F.Fab") (effects (font (size 0.5 0.5) (thickness 0.08))))
	(fp_line (start -1.650 -2.700) (end 1.650 -2.700) (stroke (width 0.15) (type solid)) (layer "F.SilkS"))
	(fp_rect (start -1.550 -2.600) (end 1.550 1.600) (stroke (width 0.05) (type solid)) (fill none) (layer "F.CrtYd"))
	(pad "1" smd rect (at 0 -0.500) (size 2.600 4.000) (layers "F.Cu" "F.Mask"))
)
