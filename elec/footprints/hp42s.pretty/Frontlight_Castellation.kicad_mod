(footprint "Frontlight_Castellation"
	(version 20221018)
	(generator "hand")
	(layer "F.Cu")
	(descr "Plated half-hole (castellation) for the frontlight sliver's end edge. Origin is the HOLE CENTRE, which sits ON the board outline; the sliver's material is at +y, and the half of the pad at -y is removed when the outline is routed. Pairs with hp42s:Frontlight_SliverLand on the main board. Fab note: this requires plated half-holes / castellated edges, which is an option to tick, not a default.")
	(tags "castellation castellated half-hole edge frontlight sliver board-to-board")
	(attr through_hole)
	(fp_text reference "REF**" (at 0 3.40) (layer "F.SilkS") (effects (font (size 1 1) (thickness 0.15))))
	(fp_text value "Frontlight_Castellation" (at 0 4.60) (layer "F.Fab") (effects (font (size 1 1) (thickness 0.15))))
	(fp_line (start -1.600 0) (end 1.600 0) (stroke (width 0.05) (type dot)) (layer "F.Fab"))
	(fp_text user "board edge" (at 0 -0.90) (layer "F.Fab") (effects (font (size 0.5 0.5) (thickness 0.08))))
	(fp_line (start -1.300 2.100) (end 1.300 2.100) (stroke (width 0.15) (type solid)) (layer "F.SilkS"))
	(fp_rect (start -1.300 -0.200) (end 1.300 2.200) (stroke (width 0.05) (type solid)) (fill none) (layer "F.CrtYd"))
	(pad "1" thru_hole rect (at 0 0.300) (size 2.000 3.000) (drill 1.200 (offset 0 -0.300)) (layers "*.Cu" "*.Mask"))
)
