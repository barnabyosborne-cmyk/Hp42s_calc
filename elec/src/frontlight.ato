from "parts.ato" import TPS61165, FrontlightInductor, SchottkyDiode
from "parts.ato" import FrontlightLED, Resistor, Capacitor, SliverLand

# ---------------------------------------------------------------------------
# frontlight.ato -- the optional edge-lit reading light.
#
# E-paper is reflective, so it cannot have a backlight. What it can have is
# what every Kindle has: a light guide lying ON TOP of the panel, injected
# from one edge, with an extraction pattern on its upper face that throws the
# light down onto the ink. The guide is 1.0 mm cast acrylic and doubles as the
# display window. See docs/front-face.md for the optics and the laser work.
#
# Nothing here is fitted on a unit without a guide. That is the reason it is
# allowed to cost about 5 uA standing (below), against a board that otherwise
# sits at 10 uA switched off.
#
# TWO MODULES, ON TWO DIFFERENT BOARDS.
#
#   Frontlight       the driver. On the main board, in the strip between the
#                    panel and the keyboard.
#   FrontlightStrip  the four LEDs. NOT instantiated by hp42s.ato, because
#                    they do not go on the main board at all.
#
# Why the LEDs are somewhere else: the guide sits on the panel, so its edge
# runs from 1.1 to 2.1 mm above the board's top copper, optical centre 1.6.
# A 1208 part soldered flat to the board emits at 0.5 mm. That is 1.1 mm of
# miss, which is most of the light. A 1.0 mm FR4 sliver lying on the main
# board puts the LED centres at 1.5 mm, which is 0.1 mm out and invisible.
# So the main board ends at two solder pads and two short wires go to it.
#
# Why a boost rather than four resistors off SYS. The white 599 is 3.4 V
# typical forward, 3.7 V worst case, and SYS is the cell at 3.0 to 4.2 V.
# There is no headroom to ballast with at a half-empty cell, and none at all
# at a low one. Series on a boost fixes that, and as a side effect makes the
# four currents identical and the brightness independent of charge state, so
# there is nothing for the firmware to compensate.
#
# Why it can sit next to the panel's own converter. This is a second fast
# switching node on a board that works hard to keep the first one away from
# the panel's SPI. Two things contain it: it goes at the right-hand end of
# the strip, as far from the FPC connector and the panel's booster as the
# board allows, and it only runs when the user has asked for light, which is
# not while the panel is being refreshed in the dark.
# ---------------------------------------------------------------------------

module Frontlight:
    # --- interface ----------------------------------------------------------
    signal sys      # the cell, 3.0 to 4.2 V, ahead of the buck-boost
    signal gnd
    signal pwm      # from a GPIO. Low or high impedance = off.

    # --- internal nodes -----------------------------------------------------
    signal sw       # inductor / SW / diode anode
    signal vled     # boost output, about 13.8 V, to the LED string's anode
    signal fb       # string cathode back into FB and the sense resistor
    signal comp
    signal ctrl     # the IC side of the CTRL series resistor

    u = new TPS61165
    u.VIN ~ sys
    u.GND ~ gnd
    u.SW  ~ sw
    u.FB  ~ fb
    u.COMP ~ comp
    u.CTRL ~ ctrl

    # --- the boost ----------------------------------------------------------
    l_fl = new FrontlightInductor
    l_fl.p1 ~ sys
    l_fl.p2 ~ sw

    # 1N5819HW again, the same part as the panel's charge pump, so the BOM
    # does not grow a line. 40 V and 1 A against 13.8 V and about 100 mA in
    # normal running.
    #
    # 40 V IS THE NUMBER THAT MATTERS, and not because of the LED string.
    # SLVS790E section 9.1.3 says the diode's reverse breakdown must exceed
    # the OPEN LED protection voltage, which section 7.4 gives as 37 V
    # minimum, 38 typical, 39 maximum measured on SW. TI's own recommended
    # parts, the MBR0540 and the ZHCS400, are both 40 V, so this one is in
    # the right class -- but it is 1 V of margin on a fault the LEDs on a
    # sliver at the end of two hand-soldered wires can actually produce.
    # A Nexperia PMEG6010CEH is 60 V in the same SOD-123 outline if you want
    # the margin and can spare a BOM line.
    d_fl = new SchottkyDiode
    d_fl.anode ~ sw
    d_fl.cathode ~ vled

    # Output cap: 1 uF, 50 V, 0805. NOT the 25 V 0603 part the panel rails
    # use, which is what this was until the datasheet turned up.
    #
    # In normal running it sees 13.8 V. What sets the rating is the fault:
    # if the LED string opens, the boost runs the output up until the open
    # LED protection trips, and SLVS790E puts that at up to 39 V on SW. A
    # 25 V part there dies, and takes the 39 V with it into whatever is
    # nearest. 50 V in 0805 keeps useful capacitance at 13.8 V after DC bias
    # derating, which a 50 V 0603 would not.
    #
    # TI's recommended operating range for this cap is 1 to 10 uF
    # (SLVS790E section 7.2), so 1 uF is the bottom of the range and there is
    # room to go up if the string ever looks ripply.
    c_out = new Capacitor
    c_out.value = "1u 50V"
    c_out.footprint = "Capacitor_SMD:C_0805_2012Metric"
    c_out.p1 ~ vled
    c_out.p2 ~ gnd

    # TI ask for 1 uF minimum on the input (SLVS790E section 7.2). 4.7 uF
    # because this sits directly on SYS, which the whole calculator shares,
    # and a 1.2 MHz switcher pulling 90 mA off a cell through a millimetre of
    # track is a ripple source the panel's SPI does not need.
    c_in = new Capacitor
    c_in.value = "4u7"
    c_in.footprint = "Capacitor_SMD:C_0603_1608Metric"
    c_in.p1 ~ sys
    c_in.p2 ~ gnd

    c_comp = new Capacitor
    c_comp.value = "220n"
    c_comp.p1 ~ comp
    c_comp.p2 ~ gnd

    # --- current set --------------------------------------------------------
    # SLVS790E equation 7: ILED = VFB / RSET, with VFB regulated to 200 mV.
    # So R = 0.2 / I. 10 Ohm is 20 mA, which is the LED's
    # rated maximum and the brightest the light will ever go. Everything
    # below that is PWM duty on CTRL, which is how the part is meant to be
    # dimmed. At 20 mA the string is 13.8 V and pulls about 88 mA off the
    # cell -- roughly 18 hours from 1600 mAh. A 5 mA reading level is about
    # 20 mA off the cell and 80 hours.
    r_set = new Resistor
    r_set.value = "10"
    r_set.p1 ~ fb
    r_set.p2 ~ gnd

    # --- driving CTRL, and keeping it off -----------------------------------
    # Two resistors, and both are in the datasheet rather than my taste.
    #
    # The series one: CTRL is not just a PWM input, it is also the EasyScale
    # one-wire interface, and the part can pull CTRL down itself to
    # acknowledge a command. SLVS790E says that with a push-pull driver -- an
    # ESP32 GPIO is exactly that -- a series resistor limiting CTRL current
    # to 500 uA is recommended, both for an accidentally requested
    # acknowledge and to protect the internal ACKN-MOSFET. 3.3 V over 10 k is
    # 330 uA, inside that.
    #
    # The pull-down: CTRL low is shutdown, and the driving GPIO is high
    # impedance at reset and through boot, so without it the frontlight's
    # state during boot is whatever leakage decides. It goes on the IC side
    # of the series resistor, so it holds CTRL down rather than the GPIO net.
    # 1 M against the part's input leakage holds CTRL under 0.1 V and costs
    # 4.2 uA at a full cell; 4.7 M would be a fifth of that but leaves CTRL
    # at nearly half a volt, too close to the threshold to trust.
    #
    # The two together divide 3.3 V by 1.01, so CTRL still sees 3.27 V high.
    r_ctrl_series = new Resistor
    r_ctrl_series.value = "10k"
    r_ctrl_series.p1 ~ pwm
    r_ctrl_series.p2 ~ ctrl

    r_ctrl = new Resistor
    r_ctrl.value = "1M"
    r_ctrl.p1 ~ ctrl
    r_ctrl.p2 ~ gnd

    # --- out to the LED sliver ----------------------------------------------
    # Two soldered wires, not a connector: a connector inside a resin case
    # that is never opened is a part that can work loose, and it would have
    # to be shorter than 1 mm to fit under the guide.
    # 2.0 x 2.0 mm lands, not the 1.5 mm round test points these were until
    # 24 September 2026. See SliverLand in parts.ato: nothing probes these, a
    # wire carrying about 88 mA is soldered to them, and the joint has to stay
    # under 1.1 mm tall because the light guide's edge starts there.
    #
    # The instance names are kept so the re-import matches them by tstamp and
    # the placement survives. The designator prefix is kept at TP for the same
    # reason: it is still TP1 and TP2, and place_board.py knows them by name.
    pad_a = new SliverLand
    pad_a.value = "FL+"
    pad_a.p ~ vled

    pad_k = new SliverLand
    pad_k.value = "FL-"
    pad_k.p ~ fb


module FrontlightStrip:
    # The 1.0 mm FR4 sliver. Its own little board, about 60 x 4 mm, lying on
    # the main board in the strip between the panel and the keyboard, with
    # the four LEDs looking up the short axis of the display.
    #
    # NOT instantiated by hp42s.ato. It is here so the string, its polarity
    # and its footprint are captured in one place with the driver that feeds
    # it, and so this file is what gets built when the sliver is laid out.
    #
    # Spacing: four on a 15 mm pitch across the 60 mm injection edge, at 7.5,
    # 22.5, 37.5 and 52.5 mm. Two things cover the ends and the near-edge hot
    # spots for free -- the active area starts 2.798 mm in from the glass
    # edge on this axis, so there is a mixing zone of dead glass before the
    # first visible pixel, and the 56.00 mm aperture hides about 2 mm at each
    # end of the 60.088 mm active area.
    signal anode    # to FL+ on the main board
    signal cathode  # to FL-

    signal n1
    signal n2
    signal n3

    d1 = new FrontlightLED
    d2 = new FrontlightLED
    d3 = new FrontlightLED
    d4 = new FrontlightLED

    d1.anode ~ anode
    d1.cathode ~ n1
    d2.anode ~ n1
    d2.cathode ~ n2
    d3.anode ~ n2
    d3.cathode ~ n3
    d4.anode ~ n3
    d4.cathode ~ cathode
