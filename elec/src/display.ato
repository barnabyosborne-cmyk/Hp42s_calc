from "parts.ato" import DisplaytechModule, RV8263C7
from "parts.ato" import Capacitor, CapBoost, Resistor

# ---------------------------------------------------------------------------
# display.ato -- the Displaytech 64128M COG and what it needs.
#
# This is the `dt` branch. The Sharp LS032B7DD02 version is on `mip`
# (shelved 1 October 2026) and the e-paper one on `main`.
#
# The 64128M is 128 x 64 FSTN glass with an ST7565R-G bonded to it (COG).
# Pin list from Displaytech's 64128M COG series specification, page 7. The
# module takes 3.0 V +/- 5 % (page 3); the ST7565R itself runs 1.8-3.3 V, so
# it is fed from v3v3 and the contrast is set in firmware (electronic volume)
# to suit. Everything the controller needs off the glass is capacitors:
#
#   The 4x voltage booster: CAP1P-CAP1N, CAP2P-CAP2N and CAP3P-CAP1N, plus
#         VOUT to VSS. VOUT reaches 4 x VDD, 13.2 V, so these are 25 V parts.
#   The LCD bias: V0..V4 each to VSS. V0 is the drive voltage, about 9 V.
#
# The interface is the 4-wire serial one: P/S low, SCL on D6, SI on D7, A0
# picks command or data, CS1 active low. D0-D5, /RD and /WR are unused in
# serial mode and must not float, so they are tied off; C86 is ignored in
# serial mode and tied low.
#
# The RV-8263 RTC stays from the `mip` board as the calculator's clock (the
# ESP32's RC drifts minutes a day). Its CLKOUT is no longer needed, so CLKOE
# is held low and CLKOUT left open.
# ---------------------------------------------------------------------------

module DisplayDrive:
    # --- interface to the rest of the board ---------------------------------
    signal v3v3
    signal gnd
    signal cs          # CS1, active low
    signal rst         # /RES, active low
    signal a0          # high = data, low = command
    signal sck
    signal mosi
    signal i2c_sda
    signal i2c_scl

    # --- internal nodes -----------------------------------------------------
    signal vout
    signal cap1n
    signal v0
    signal v1
    signal v2
    signal v3
    signal v4

    panel = new DisplaytechModule
    panel.CS1 ~ cs
    panel.RES ~ rst
    panel.A0 ~ a0
    panel.WR ~ v3v3
    panel.RD ~ v3v3
    panel.D0 ~ gnd
    panel.D1 ~ gnd
    panel.D2 ~ gnd
    panel.D3 ~ gnd
    panel.D4 ~ gnd
    panel.D5 ~ gnd
    panel.D6 ~ sck
    panel.D7 ~ mosi
    panel.VDD ~ v3v3
    panel.VSS ~ gnd
    panel.VOUT ~ vout
    panel.CAP1N ~ cap1n
    panel.V0 ~ v0
    panel.V1 ~ v1
    panel.V2 ~ v2
    panel.V3 ~ v3
    panel.V4 ~ v4
    panel.C86 ~ gnd
    panel.PS ~ gnd

    c_vdd = new Capacitor
    c_vdd.value = "1u"
    c_vdd.p1 ~ v3v3
    c_vdd.p2 ~ gnd

    # --- the booster ----------------------------------------------------------
    signal cap1p
    signal cap2p
    signal cap2n
    signal cap3p
    panel.CAP1P ~ cap1p
    panel.CAP2P ~ cap2p
    panel.CAP2N ~ cap2n
    panel.CAP3P ~ cap3p

    c_cap1 = new Capacitor
    c_cap1.value = "1u"
    c_cap1.p1 ~ cap1p
    c_cap1.p2 ~ cap1n

    c_cap2 = new Capacitor
    c_cap2.value = "1u"
    c_cap2.p1 ~ cap2p
    c_cap2.p2 ~ cap2n

    c_cap3 = new Capacitor
    c_cap3.value = "1u"
    c_cap3.p1 ~ cap3p
    c_cap3.p2 ~ cap1n

    c_vout = new Capacitor
    c_vout.value = "1u"
    c_vout.p1 ~ vout
    c_vout.p2 ~ gnd

    # --- the bias -------------------------------------------------------------
    c_v0 = new Capacitor
    c_v0.value = "1u"
    c_v0.p1 ~ v0
    c_v0.p2 ~ gnd

    c_v1 = new Capacitor
    c_v1.value = "1u"
    c_v1.p1 ~ v1
    c_v1.p2 ~ gnd

    c_v2 = new Capacitor
    c_v2.value = "1u"
    c_v2.p1 ~ v2
    c_v2.p2 ~ gnd

    c_v3 = new Capacitor
    c_v3.value = "1u"
    c_v3.p1 ~ v3
    c_v3.p2 ~ gnd

    c_v4 = new Capacitor
    c_v4.value = "1u"
    c_v4.p1 ~ v4
    c_v4.p2 ~ gnd

    # /RES held high through an ESP32 reset, when its pins float, so the
    # panel keeps what it shows.
    r_rst = new Resistor
    r_rst.value = "100k"
    r_rst.p1 ~ rst
    r_rst.p2 ~ v3v3

    # --- the clock ------------------------------------------------------------
    signal clkoe
    rtc = new RV8263C7
    rtc.VDD ~ v3v3
    rtc.VSS ~ gnd
    rtc.SCL ~ i2c_scl
    rtc.SDA ~ i2c_sda
    rtc.CLKOE ~ clkoe

    c_rtc = new Capacitor
    c_rtc.value = "100n"
    c_rtc.p1 ~ v3v3
    c_rtc.p2 ~ gnd

    # CLKOE low: no 32.768 kHz on an unconnected pin.
    r_clkoe = new Resistor
    r_clkoe.value = "1M"
    r_clkoe.p1 ~ clkoe
    r_clkoe.p2 ~ gnd
