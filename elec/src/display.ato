from "parts.ato" import MIPConnector, TPS610997, RV8263C7, MIPBoostInductor
from "parts.ato" import Capacitor, CapBoost, Resistor

# ---------------------------------------------------------------------------
# display.ato -- the Sharp LS032B7DD02 memory LCD and what it needs.
#
# This is the `mip` branch. The e-paper version of this file, with its
# +22/-20 V gate booster, is on `main`; see docs/mip-display.md for why the
# two boards differ.
#
# A memory-in-pixel panel is much simpler to drive than e-paper. It wants:
#
#   5 V.  VDD and VDDA are both 4.8-5.5 V (spec LD-2023X13 page 25). Sharp
#         allows them to rise and fall together (page 23, notes 1 and 2), so
#         they are one net here, fed by a TPS610997 boost from SYS. When the
#         panel is off, EN is low and the boost disconnects its output
#         completely, so the panel draws nothing.
#
#   A 1-10 Hz square wave on EXTCOMIN, with EXTMODE tied high, for as long as
#         it shows a picture -- including while the calculator is "off" and
#         the ESP32 is in deep sleep. The RV-8263's CLKOUT, set to 1 Hz,
#         does that for 190 nA and no CPU time. CLKOE comes from a GPIO: the
#         RTC powers up giving 32.768 kHz, and CLKOE low holds CLKOUT low, so
#         nothing drives the panel until firmware has set 1 Hz and turned the
#         5 V on. That matters twice: out-of-spec EXTCOMIN, and a 3.3 V edge
#         pushed into an unpowered panel's input.
#
#   3-wire SPI (SCLK, SI, SCS active high) and DISP. 3.3 V logic is inside
#         their VIH (2.7 V min at VDD 5 V). All of them must be low whenever
#         the 5 V is off, and never floating when it is on (page 16).
#
# The RTC also gives the calculator a clock that keeps time properly, which
# the ESP32's own RC oscillator does not.
# ---------------------------------------------------------------------------

module DisplayDrive:
    # --- interface to the rest of the board ---------------------------------
    signal v3v3
    signal sys
    signal gnd
    signal cs          # SCS, active high
    signal disp        # DISP, high = image shown
    signal pwr_en      # high = 5 V on
    signal clkoe       # high = EXTCOMIN running
    signal sck
    signal mosi
    signal i2c_sda
    signal i2c_scl

    # --- internal nodes -----------------------------------------------------
    signal v5          # the panel's VDD and VDDA
    signal sw5         # the boost's switch node
    signal extcomin

    panel = new MIPConnector
    panel.SCLK ~ sck
    panel.SI ~ mosi
    panel.SCS ~ cs
    panel.DISP ~ disp
    panel.EXTCOMIN ~ extcomin
    panel.EXTMODE ~ v5
    panel.VDD ~ v5
    panel.VDDA ~ v5
    panel.VSS ~ gnd
    panel.VSSA ~ gnd
    panel.MP ~ gnd

    # Sharp recommends a capacitor on VDD+VDDA at the panel (page 24), for
    # the current peaks when COM inverts.
    c_panel = new Capacitor
    c_panel.value = "1u"
    c_panel.footprint = "Capacitor_SMD:C_0603_1608Metric"
    c_panel.p1 ~ v5
    c_panel.p2 ~ gnd

    # --- the 5 V rail -------------------------------------------------------
    boost = new TPS610997
    boost.VIN ~ sys
    boost.SW ~ sw5
    boost.VOUT ~ v5
    boost.EN ~ pwr_en
    boost.GND ~ gnd
    boost.FB ~ gnd

    l_boost = new MIPBoostInductor
    l_boost.p1 ~ sys
    l_boost.p2 ~ sw5

    # 10 uF in, as TI recommends; 20 uF out, TI's stated minimum for a 1-2.2 uH
    # inductor (8.2.2.5). CL10A106KP8NNNC, JLC Basic C19702.
    c_in = new CapBoost
    c_in.value = "10u 10V"
    c_in.p1 ~ sys
    c_in.p2 ~ gnd

    c_out1 = new CapBoost
    c_out1.value = "10u 10V"
    c_out1.p1 ~ v5
    c_out1.p2 ~ gnd

    c_out2 = new CapBoost
    c_out2.value = "10u 10V"
    c_out2.p1 ~ v5
    c_out2.p2 ~ gnd

    # EN must never float (TI table 5-1). While the ESP32 is in reset its
    # pins are all inputs, so this holds the panel off.
    r_en = new Resistor
    r_en.value = "1M"
    r_en.p1 ~ pwr_en
    r_en.p2 ~ gnd

    # --- the clock, and EXTCOMIN --------------------------------------------
    rtc = new RV8263C7
    rtc.VDD ~ v3v3
    rtc.VSS ~ gnd
    rtc.SCL ~ i2c_scl
    rtc.SDA ~ i2c_sda
    rtc.CLKOE ~ clkoe
    rtc.CLKOUT ~ extcomin

    c_rtc = new Capacitor
    c_rtc.value = "100n"
    c_rtc.p1 ~ v3v3
    c_rtc.p2 ~ gnd

    # CLKOE low stops the square wave; hold it low through a reset for the
    # same reason as EN.
    r_clkoe = new Resistor
    r_clkoe.value = "1M"
    r_clkoe.p1 ~ clkoe
    r_clkoe.p2 ~ gnd
