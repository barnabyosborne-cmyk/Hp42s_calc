from "parts.ato" import ESP32S3MINI1, Buzzer, IRLED, TactSwitchSide, StatusLED
from "parts.ato" import Resistor, Capacitor, Diode, NFET, TestPad, ChassisPad
from "display.ato" import DisplayDrive
from "power.ato" import Power
from "keypad.ato" import Keypad
from "frontlight.ato" import Frontlight

# ---------------------------------------------------------------------------
# hp42s.ato -- top level.
#
# An HP-42S-shaped calculator running Plus42 on an ESP32-S3, with a 2.66 inch
# e-paper panel and a 37-key metal dome keypad. Case 148 x 80 x 15 mm.
#
# The GPIO map below is not free choice. Three things pin it down:
#   - IO19/IO20 are the USB PHY. Fixed in silicon, not reassignable.
#   - IO1-IO7 are RTC-capable, which is what lets the columns be ext1 wake
#     sources. The keypad wakes the chip with no scanner IC and no standing
#     current, and that is most of the battery life.
#   - IO33-IO38 are free ONLY on the -N8 module, which has no PSRAM. On an
#     -N4R2 the octal PSRAM takes them and the panel interface has to move.
#
# Strapping pins, per Espressif table 4-1: IO0 (weak pull-up), IO3 (floating),
# IO45 (weak pull-down) and IO46 (weak pull-down). Those defaults are already
# the configuration this board wants -- SPI boot, VDD_SPI at 3.3 V, ROM
# messages on, JTAG over USB -- so IO3, IO45 and IO46 get nothing on them at
# all. IO0 carries the BOOT button and its test pad and nothing else; pulling
# it down with IO46 left at its default 0 is exactly Espressif's joint
# download boot.
#
# Chip pins 26-32 are the internal SPI flash. Of those, only IO26 comes out of
# the module, and it is free on the -N8 -- it is the PSRAM pin on an -N4R2.
#
# Still free: IO26, IO40, IO42. IO40 is earmarked for driving the sounder
# in antiphase if it needs to be louder. IO41 has gone to the frontlight's
# PWM -- it is only wired on units that have a light guide, but the net is
# always in the netlist. Hardware JTAG on IO39-IO42 is already gone, see
# the status LED below.
# ---------------------------------------------------------------------------

module HP42S:
    signal gnd
    signal v3v3

    # Named so the netlist carries readable net names into KiCad. Without
    # these the panel bus comes through as net, net-1, net-2 ...
    signal epd_cs
    signal epd_dc
    signal epd_rst
    signal epd_busy
    signal epd_sck
    signal epd_mosi
    signal buzzer
    signal ir_led
    signal uart0_tx
    signal uart0_rx
    signal boot
    signal sounder
    signal led_red
    signal led_green
    signal en
    signal frontlight_pwm

    power = new Power
    power.gnd ~ gnd
    power.v3v3 ~ v3v3

    keypad = new Keypad

    mcu = new ESP32S3MINI1
    mcu.GND1 ~ gnd
    mcu.GND2 ~ gnd
    mcu.GND42 ~ gnd
    mcu.GND43 ~ gnd
    mcu.GND46 ~ gnd
    mcu.GND47 ~ gnd
    mcu.GND48 ~ gnd
    mcu.GND49 ~ gnd
    mcu.GND50 ~ gnd
    mcu.GND51 ~ gnd
    mcu.GND52 ~ gnd
    mcu.GND53 ~ gnd
    mcu.GND54 ~ gnd
    mcu.GND55 ~ gnd
    mcu.GND56 ~ gnd
    mcu.GND57 ~ gnd
    mcu.GND58 ~ gnd
    mcu.GND59 ~ gnd
    mcu.GND60 ~ gnd
    mcu.GND61 ~ gnd
    mcu.GND62 ~ gnd
    mcu.GND63 ~ gnd
    mcu.GND64 ~ gnd
    mcu.GND65 ~ gnd
    mcu.V3P3 ~ v3v3

    # --- reset / enable ------------------------------------------------------
    mcu.EN ~ en
    mcu.IO0 ~ boot
    mcu.IO43 ~ uart0_tx
    mcu.IO44 ~ uart0_rx

    r_en = new Resistor
    r_en.value = "10k"
    r_en.p1 ~ en
    r_en.p2 ~ v3v3

    c_en = new Capacitor
    c_en.value = "1u"
    c_en.p1 ~ en
    c_en.p2 ~ gnd

    # Reset button, top edge of the case, side-actuated, on the BACK of the
    # board. It pulls the module's EN low, which is a hardware reset of the
    # chip -- it does not go near the firmware, so it works when the firmware
    # has stopped working, which is the only time anyone will use it.
    #
    # Recess it in the case. This is not a key, it is the thing you press
    # with the corner of a business card when Plus42 has wedged, and a button
    # you can hit while holding the calculator is a button you will hit.
    #
    # The 10k/1uF above debounce it for free: the cap holds EN down for about
    # 10 ms after release, which is longer than the contact bounce.
    sw_reset = new TactSwitchSide
    sw_reset.a ~ en
    sw_reset.b ~ gnd
    sw_reset.mp ~ gnd

    # BOOT, beside it on the top edge. This is the recovery path and there is
    # no other one.
    #
    # A dev board gets away without a BOOT button because its USB-UART bridge
    # wiggles EN and IO0 from the host, and this board has no bridge -- the
    # S3 drives USB itself. The moment the firmware claims the USB OTG
    # peripheral for mass storage, the USB-Serial/JTAG path that esptool
    # could otherwise reset through is no longer on those pins. And if the
    # firmware is broken enough not to enumerate at all, nothing on the host
    # can reach the chip.
    #
    # So: hold BOOT, tap RESET, release BOOT, and the ROM bootloader comes up
    # no matter what is in flash. Without this button that sequence needs the
    # case open and a wire on TP8.
    #
    # Recess it deeper than RESET. It is pressed roughly never.
    sw_boot = new TactSwitchSide
    sw_boot.a ~ boot
    sw_boot.b ~ gnd
    sw_boot.mp ~ gnd

    # Espressif's own peripheral schematic, figure 9-1, puts 22 uF AND 100 nF
    # on the module's 3V3 pin. Only the 100 nF was here, and the 22 uF is the
    # one that matters: a Bluetooth LE transmit burst is 189 mA at 0 dBm off a
    # rail rated 400 mA, and it arrives in microseconds. The regulator's own
    # 22 uF is at the other end of the board and behind whatever inductance
    # the 3V3 trace has. This one goes hard against pin 3.
    c_mcu_bulk = new Capacitor
    c_mcu_bulk.value = "22u"
    c_mcu_bulk.footprint = "Capacitor_SMD:C_0805_2012Metric"
    c_mcu_bulk.p1 ~ v3v3
    c_mcu_bulk.p2 ~ gnd

    c_mcu = new Capacitor
    c_mcu.value = "100n"
    c_mcu.p1 ~ v3v3
    c_mcu.p2 ~ gnd

    # --- USB -----------------------------------------------------------------
    mcu.USB_DM ~ power.usb_dm
    mcu.USB_DP ~ power.usb_dp

    # --- I2C and charge status ----------------------------------------------
    mcu.IO17 ~ power.i2c_sda
    mcu.IO18 ~ power.i2c_scl
    mcu.IO48 ~ power.chg_stat
    mcu.IO15 ~ power.chg_stat2

    # --- keypad: columns on RTC pins, rows on ordinary GPIO -------------------
    mcu.IO1 ~ keypad.col0
    mcu.IO2 ~ keypad.col1
    mcu.IO4 ~ keypad.col2
    mcu.IO5 ~ keypad.col3
    mcu.IO6 ~ keypad.col4
    mcu.IO7 ~ keypad.col5

    mcu.IO8  ~ keypad.row0
    mcu.IO9  ~ keypad.row1
    mcu.IO10 ~ keypad.row2
    mcu.IO11 ~ keypad.row3
    mcu.IO12 ~ keypad.row4
    mcu.IO13 ~ keypad.row5
    mcu.IO14 ~ keypad.row6

    # --- e-paper panel -------------------------------------------------------
    # BUSY is an input and also the light-sleep wake source during a refresh.
    # Sleeping on BUSY rather than spinning through the ~400 ms partial update
    # is worth about 5x on the energy cost of a keystroke.
    mcu.IO33 ~ epd_cs
    mcu.IO34 ~ epd_dc
    mcu.IO35 ~ epd_rst
    mcu.IO36 ~ epd_busy
    mcu.IO37 ~ epd_sck
    mcu.IO38 ~ epd_mosi

    # Everything the panel needs, including the boost converter that makes
    # its +22 V and -20 V gate rails. See display.ato -- the short version is
    # that the controller is bonded to the panel's own glass, so there is no
    # driver board to buy, but there is a driver circuit to build.
    display = new DisplayDrive
    display.v3v3 ~ v3v3
    display.gnd  ~ gnd
    display.cs   ~ epd_cs
    display.dc   ~ epd_dc
    display.rst  ~ epd_rst
    display.busy ~ epd_busy
    display.sck  ~ epd_sck
    display.mosi ~ epd_mosi

    # --- buzzer --------------------------------------------------------------
    # Murata's own drive, figure A of the PKLCS1212E specification: the IC
    # output, a series resistor of 1k to 2k, then the sounder to ground. That
    # is the whole circuit.
    #
    # It used to be a FET low-side switch with a flyback diode, which is how
    # you drive a magnetic buzzer and not how you drive a piezo one. A piezo
    # element is a capacitor: with a FET pulling one end down and nothing
    # pulling it back up, it charges once, clicks, and then sits there. It
    # needs to be driven both ways, which one GPIO on LEDC does directly.
    #
    # 3.3 Vp-p gets Murata's rated 75 dB at 10 cm. If that turns out too
    # quiet, driving ls.p from a second GPIO in antiphase doubles the swing
    # for about 6 dB more -- IO40 is free and that is the only change needed.
    ls = new Buzzer
    ls.p ~ gnd
    r_buz = new Resistor
    r_buz.value = "1k"
    mcu.IO21 ~ buzzer
    r_buz.p1 ~ buzzer
    r_buz.p2 ~ sounder
    sounder ~ ls.n

    # --- IR printing (HP-82240) ----------------------------------------------
    ir = new IRLED
    ir.anode ~ v3v3
    q_ir = new NFET
    r_ir_series = new Resistor
    r_ir_series.value = "22"
    r_ir_series.p1 ~ ir.cathode
    r_ir_series.p2 ~ q_ir.drain
    q_ir.source ~ gnd
    r_ir_gate = new Resistor
    r_ir_gate.value = "1k"
    mcu.IO47 ~ ir_led
    r_ir_gate.p1 ~ ir_led
    r_ir_gate.p2 ~ q_ir.gate

    # --- status LED ----------------------------------------------------------
    # Top edge, side-emitting, next to the two buttons. Dialight 599-0Q70-247F:
    # two dice, red and yellow-green, sharing a COMMON ANODE. So a channel is
    # driven LOW to light, which is the opposite of what this block used to do.
    #
    # Red, green and both-together-as-amber is three states out of two pins,
    # which covers booting, nominal and error without a third die. See
    # parts.ato for why there is no blue one worth having on a 3.3 V rail.
    #
    # Dark whenever the pins are high impedance, which is still true here: at
    # reset the pin is high impedance, so no current flows and the die is off.
    # An always-on indicator would be milliamps against a 25 uA sleep budget
    # and would turn fifteen months into about a week.
    #
    # IO39 is one of the four JTAG pins. Taking it means giving up hardware
    # JTAG, which this board had already lost in practice: the USB pins go to
    # the OTG peripheral for mass storage, and debugging runs over the UART0
    # test pads. IO16 is simply spare. IO40 goes back to the free list -- the
    # third channel is gone with the third die.
    #
    # 1k on a 2.0 V die off 3.3 V is about 1.3 mA, which is plenty behind a
    # diffused case window.
    mcu.IO16 ~ led_red
    mcu.IO39 ~ led_green

    led_status = new StatusLED
    led_status.anode ~ v3v3

    r_led_red = new Resistor
    r_led_red.value = "1k"
    r_led_red.p1 ~ led_red
    r_led_red.p2 ~ led_status.red

    r_led_green = new Resistor
    r_led_green.value = "1k"
    r_led_green.p1 ~ led_green
    r_led_green.p2 ~ led_status.ygreen

    # --- frontlight ----------------------------------------------------------
    # Optional, and not fitted on a unit without a light guide. IO41 was one
    # of the four pins still free; IO26 and IO42 remain, and IO40 stays
    # earmarked for driving the sounder in antiphase.
    #
    # This runs off SYS rather than 3V3, because four white LEDs in series
    # want about 13.6 V and the part is 3.4 V typical forward -- there is no
    # headroom to ballast them off a rail at all. See frontlight.ato.
    #
    # SYS is the cell, so the driver is live whenever there is a cell in the
    # case. Its shutdown current plus the 1 M holding CTRL down is about 5 uA.
    # There is no switched-off state to compare that against any more -- the
    # slider went on 24 September 2026 -- so it is 5 uA on top of the 21 uA
    # standing draw in docs/power-control.md, and it is the price of the
    # feature on the units that have it.
    mcu.IO41 ~ frontlight_pwm

    frontlight = new Frontlight
    frontlight.sys ~ power.sys
    frontlight.gnd ~ gnd
    frontlight.pwm ~ frontlight_pwm

    # --- faceplate ground bond -----------------------------------------------
    # The etched steel plate over the keyboard and display is an ESD entry
    # path the moment a finger touches it. This gives the charge somewhere to
    # go that is not through the MCU. Put it on the FRONT near the USB-C
    # shield's ground stitch, not near the module. See docs/front-face.md.
    #
    # It is one pad and a spring finger. If the plate is never fitted, it is
    # a 3 x 3 mm patch of grounded copper and costs nothing.
    plate_gnd = new ChassisPad
    plate_gnd.p ~ gnd

    # --- test pads -----------------------------------------------------------
    tp_bat = new TestPad
    tp_bat.value = "BAT"
    tp_bat.p ~ power.bat

    tp_sys = new TestPad
    tp_sys.value = "SYS"
    tp_sys.p ~ power.sys

    tp_3v3 = new TestPad
    tp_3v3.value = "3V3"
    tp_3v3.p ~ v3v3

    tp_gnd = new TestPad
    tp_gnd.value = "GND"
    tp_gnd.p ~ gnd

    tp_tx = new TestPad
    tp_tx.value = "UART0_TX"
    tp_tx.p ~ uart0_tx

    tp_rx = new TestPad
    tp_rx.value = "UART0_RX"
    tp_rx.p ~ uart0_rx

    tp_en = new TestPad
    tp_en.value = "EN"
    tp_en.p ~ en

    tp_boot = new TestPad
    tp_boot.value = "BOOT (IO0)"
    tp_boot.p ~ boot
