# ---------------------------------------------------------------------------
# parts.ato -- component declarations for the HP-42S clone.
#
# PIN NAMES, NOT PIN NUMBERS.
#
# Every IC below declares its pins by the name the datasheet uses (IN, SYS,
# BAT, ...) rather than by number. atopile is happy with either; names are
# used deliberately, because inventing pin numbers from memory is exactly the
# error that costs a board spin. When these parts are given real KiCad
# symbols, the names here have to be reconciled with the symbol's numbering.
# Until then the netlist is correct about *what connects to what* and silent
# about which physical pin that is.
#
# Footprint strings are unchecked: atopile passes them through to the netlist
# verbatim and never looks for the file. KiCad checks them at import, so every
# one below is library-qualified and was looked up in KiCad's own footprint
# library rather than guessed. Three exceptions, all marked TODO below:
# `hp42s:` is this repo's own library (elec/footprints/hp42s.pretty), which at
# the moment holds the two dome sites and nothing else. See docs/kicad-setup.md.
# ---------------------------------------------------------------------------

# NO `designator` IN THESE BODIES. Instances set their own (keypad.ato gives
# every key the core's key number, so SW19 is the `7` key). Two dead ends got
# us here: a placeholder like `designator = "R?"` in a component body is taken
# as a real designator and the second instance fails with "Designator R?
# already in use"; and the type-annotation form `designator: string` parses
# locally but is rejected by atopile's newer parser -- "expected name, got
# 'string'". Assigning per instance works in both.

# --- passives --------------------------------------------------------------

component Resistor:
    footprint = "Resistor_SMD:R_0402_1005Metric"
    designator_prefix = "R"
    value = "?"
    signal p1 ~ pin 1
    signal p2 ~ pin 2

component Capacitor:
    footprint = "Capacitor_SMD:C_0402_1005Metric"
    designator_prefix = "C"
    value = "?"
    signal p1 ~ pin 1
    signal p2 ~ pin 2

component Inductor:
    # The buck-boost's 2.2 uH. Coilcraft XFL4020-222ME, from TI's own
    # recommended list (TPS63900 table 8-2): 3.5 A saturation, 21 mOhm,
    # 4 x 4 x 2 mm. The other four on TI's list are smaller and four to five
    # times the DC resistance; this board has room on the back and would
    # rather have the efficiency, because battery life is the headline
    # number. KiCad's L_Coilcraft_XxL4020 is the land pattern for it.
    footprint = "Inductor_SMD:L_Coilcraft_XxL4020"
    designator_prefix = "L"
    value = "2u2 XFL4020-222ME"
    signal p1 ~ pin 1
    signal p2 ~ pin 2

component Diode:
    # SOD-323. KiCad numbers diode pads 1 = cathode, 2 = anode (pad 1 is the
    # marked end). Numbers, not names, because this footprint is real and its
    # pads are called 1 and 2 -- a pin called "K" would match no pad at all.
    footprint = "Diode_SMD:D_SOD-323"
    designator_prefix = "D"
    value = "?"
    signal cathode ~ pin 1
    signal anode ~ pin 2

component NFET:
    # 2N7002 small-signal N-channel, SOT-23. Numbered for the same reason as
    # the diode: SOT-23 pads are 1, 2, 3. The 2N7002 pinout is the SOT-23
    # standard, 1 = gate, 2 = source, 3 = drain.
    footprint = "Package_TO_SOT_SMD:SOT-23"
    designator_prefix = "Q"
    value = "2N7002"
    signal gate ~ pin 1
    signal source ~ pin 2
    signal drain ~ pin 3

component ChassisPad:
    # Bond pad for the etched steel faceplate, on the front near the USB-C
    # shield's ground stitch rather than near the module. A metal plate the
    # user touches is an ESD entry path straight onto the board, and this is
    # where the charge is meant to go instead of through the MCU. See
    # docs/front-face.md.
    #
    # 3 x 3 mm because what lands on it is a spring finger or a screw boss,
    # not a probe. Contact resistance does not matter; area and a reliable
    # touch do.
    footprint = "TestPoint:TestPoint_Pad_3.0x3.0mm"
    designator_prefix = "TP"
    value = "faceplate ground bond"
    signal p ~ pin 1

component TestPad:
    footprint = "TestPoint:TestPoint_Pad_D1.5mm"
    designator_prefix = "TP"
    value = "test pad"
    signal p ~ pin 1

component SliverLand:
    # Where a wire to the frontlight sliver is soldered. Two of them, 60 mm
    # apart in the strip between the panel and the keyboard.
    #
    # 2.0 x 2.0 mm square, not the 1.5 mm round TestPad these used to be.
    # Nothing probes these: a hand-soldered wire lands on them and stays, and
    # it carries about 88 mA off the cell when the light is at full. A round
    # 1.5 mm pad is a probe target. A 2 mm square gives an iron somewhere to
    # sit, takes the wire flat rather than end-on, and is four times the area
    # for a joint that has to survive a case being closed on it.
    #
    # KEEP THE JOINT UNDER 1.1 mm TALL. The light guide lies on the panel and
    # its edge runs from 1.1 to 2.1 mm above the board's top copper, which is
    # the window the LEDs themselves sit in. A blob taller than that fouls the
    # guide. 30 AWG tinned wire laid flat plus a fillet is about 0.6 mm; a
    # loop of stranded wire standing up is not.
    #
    # Square rather than round is also the orientation cue: there is no
    # polarity marking on a wire, so FL+ and FL- are told apart by the
    # silkscreen and by which end of the sliver they reach.
    footprint = "TestPoint:TestPoint_Pad_2.0x2.0mm"
    designator_prefix = "TP"
    value = "sliver land"
    signal p ~ pin 1

component SliverWirePad:
    # The other end of that wire, on the sliver itself: a 1.5 x 3.0 mm pad on
    # the 2 mm of sliver that overhangs the light guide at each end, so the
    # joint sits clear of the guide's edge. Hand soldered, so no paste.
    # Laid out by tools/make_sliver.py, not by a netlist import.
    footprint = "hp42s:Frontlight_SliverWirePad"
    designator_prefix = "TP"
    value = "sliver wire pad"
    signal p ~ pin 1

# --- keypad ----------------------------------------------------------------

component DomeKey10:
    # 10 mm four-leg metal dome, digits and operators. Snaptron F10260
    # (260 gf) or Keystone 5154TR (280 g); the pad takes either, which is
    # why it is no longer named after one of them. Keystone is the one the
    # usual distributors stock.
    # Pad 1 is the outer ring, pad 2 the centre -- see tools/gen_dome_footprints.py.
    footprint = "hp42s:Dome_4Leg_10mm"
    designator_prefix = "SW"
    value = "10mm dome, F10260 or 5154TR"
    signal ring ~ pin 1
    signal centre ~ pin 2

component DomeKey85:
    # 8.5 mm four-leg metal dome, function rows and ENTER. Snaptron F08210
    # (210 gf) or Keystone 5134TR (8.4 mm, 280 g).
    footprint = "hp42s:Dome_4Leg_8.5mm"
    designator_prefix = "SW"
    value = "8.5mm dome, F08210 or 5134TR"
    signal ring ~ pin 1
    signal centre ~ pin 2

# --- power -----------------------------------------------------------------

component BQ25185:
    # Single-cell linear charger with power path, DLH 10-pin WSON.
    # Pin numbers and names from the datasheet Barnaby supplied
    # (SLUSF65B, table 4-1). Two corrections came out of that reading:
    # there is no "CHG" pin -- status is TWO open-drain pins, STAT1 and
    # STAT2, which between them encode four states -- and ILIM and VSET are
    # one pin, programmed by a single resistor.
    #
    # Footprint: TI's DLH0010A land pattern (drawing 4226298/A) is 0.4 mm
    # pitch with a 1.5 x 0.9 mm thermal pad, which is exactly what KiCad's
    # DSQ0010A footprint provides. Same outline under two TI package codes.
    footprint = "Package_DFN_QFN:Texas_DSQ0010A_WSON-10-1EP_2x2mm_P0.4mm_EP0.9x1.5mm"
    designator_prefix = "U"
    value = "BQ25185"
    signal SYS       ~ pin 1
    signal BAT       ~ pin 2
    signal STAT2     ~ pin 3
    signal CE_N      ~ pin 4
    signal GND       ~ pin 5
    signal TS_MR     ~ pin 6
    signal ILIM_VSET ~ pin 7
    signal ISET      ~ pin 8
    signal STAT1     ~ pin 9
    signal IN        ~ pin 10
    signal PAD       ~ pin 11

component TPS63900:
    # Buck-boost to 3.3 V, 75 nA quiescent. Mandatory: the panel's VCI
    # cannot take a 4.2 V cell directly.
    #
    # There is NO feedback divider on this part -- I had invented one. The
    # output voltage is set by resistors on CFG1/CFG2/CFG3 and chosen
    # between by SEL, and all three CFG pins must not be left open.
    #
    # Package is DSK0010A, a 2.5 x 2.5 mm WSON-10, not the VQFN-12 this
    # entry used to claim. The footprint is generated from TI's own land
    # pattern by tools/gen_ic_footprints.py.
    #
    # PIN NUMBERS CONFIRMED 22 September 2026 against table 5-1 and figure
    # 5-1 of SLVSET3D (revised October 2020), from the PDF Barnaby supplied.
    # Every one of the ten below matches. The thermal pad is not optional:
    # TI's own words are "connect this pin to ground for correct operation".
    footprint = "hp42s:TI_DSK0010A_WSON-10-1EP_2.5x2.5mm_P0.5mm_EP2x1.2mm"
    designator_prefix = "U"
    value = "TPS63900DSK"
    signal EN   ~ pin 1
    signal SEL  ~ pin 2
    signal CFG1 ~ pin 3
    signal CFG2 ~ pin 4
    signal CFG3 ~ pin 5
    signal VOUT ~ pin 6
    signal LX2  ~ pin 7
    signal GND  ~ pin 8
    signal LX1  ~ pin 9
    signal VIN  ~ pin 10
    signal PAD  ~ pin 11

component MAX17048:
    # ModelGauge fuel gauge, I2C, no sense resistor. TDFN-8, 2 x 2 mm.
    #
    # The WLP is a 1.2 x 0.9 mm eight-bump wafer-level part and there is no
    # reflowing that by hand. TDFN is the same die in a package you can
    # actually place, and Maxim sells both.
    #
    # THE EXPOSED PAD IS SETTLED, 22 September 2026, and not by finding the
    # drawing. The datasheet points at Maxim outline 21-0168 and land pattern
    # 90-0065 rather than drawing either, and analog.com is blocked from this
    # session. It does not matter, for three reasons:
    #
    #  - The EP on this part is a ground and mechanical anchor, not a
    #    heatsink. The whole IC draws 3 uA, about 12 uW. There is no thermal
    #    requirement to size for.
    #  - The error is asymmetric. A land LARGER than the package's own pad
    #    risks solder bridging to the pins; a land SMALLER just solders fine
    #    with less area. KiCad's 0.8 x 1.2 mm is conservative for a 2 x 2 mm
    #    TDFN-8 -- the die pad on parts like this is typically around
    #    1.6 x 1.2 -- so it already errs the safe way.
    #  - KiCad's footprint windows the paste: the EP copper is one pad and
    #    the paste is four smaller apertures, which is what stops the part
    #    floating on excess solder. That is the failure this land is actually
    #    exposed to, and it is already handled.
    #
    # Pin numbers confirmed against the pin/bump description table on page 6
    # of the MAX17048/MAX17049 datasheet.
    #
    # On the MAX17048 specifically, VDD is the sense input and goes to the
    # cell; CELL is not internally connected at all. It is the MAX17049,
    # the 2-cell part, that uses CELL. Easy to wire the wrong one.
    footprint = "Package_DFN_QFN:TDFN-8-1EP_2x2mm_P0.5mm_EP0.8x1.2mm"
    designator_prefix = "U"
    value = "MAX17048G+T10"
    signal CTG   ~ pin 1
    signal CELL  ~ pin 2
    signal VDD   ~ pin 3
    signal GND   ~ pin 4
    signal ALRT_N ~ pin 5
    signal QSTRT ~ pin 6
    signal SCL   ~ pin 7
    signal SDA   ~ pin 8
    signal PAD   ~ pin 9

component USBCReceptacle:
    # 16-pin USB-C 2.0 receptacle, GCT USB4105-GF-A. Top-mount horizontal,
    # body 8.94 x 7.35 mm, mouth flush with the board edge.
    #
    # THIS WAS A SAME SKY UJ20-C-H-G-SMT-1A-P16-TR until 22 September 2026,
    # on a land pattern generated by hand in tools/gen_ic_footprints.py. The
    # swap is not about the connector -- both are ordinary 16-pin USB 2.0
    # receptacles -- it is about the land pattern. KiCad's GCT footprint is
    # drawn from GCT's own document, so this board stops maintaining a
    # hand-made footprint for the one part that gets mechanically abused.
    # The pad names are identical (A1..B12 and SH), so nothing in the netlist
    # changed, and the mouth still sits at y = 3.675 from the footprint
    # origin, so the placement constant did not change either.
    #
    # IT STILL HAS THROUGH-HOLE SHELL LEGS, and so does every other 16-pin
    # Type-C receptacle in KiCad's library. That is not an oversight: the
    # legs are what stops a yanked cable lifting the pads off a board that
    # gets charged daily. The fillets they leave on the back are a case
    # problem, not a connector problem -- see docs/top-edge.md.
    #
    # Pin NAMES here are the USB-C contact names, because that is what the
    # footprint's pads are actually called -- A1, A4, B5 and so on, straight
    # off the connector standard. This is the rare case where the datasheet
    # names and the footprint's pad names are the same thing.
    #
    # The two rows are what make the plug reversible: rotate the plug and A
    # swaps with B. So VBUS is four pads, GND is four pads, and D+/D- are two
    # each and get tied together for USB 2.0. CC1 and CC2 must NOT be tied --
    # they are how the sink tells the source which way round the plug went in.
    # SBU1/SBU2 are for alternate modes and stay unconnected.
    footprint = "Connector_USB:USB_C_Receptacle_GCT_USB4105-xx-A_16P_TopMnt_Horizontal"
    designator_prefix = "J"
    value = "GCT USB4105-GF-A"
    signal GND_A1  ~ pin A1
    signal VBUS_A4 ~ pin A4
    signal CC1     ~ pin A5
    signal DP_A6   ~ pin A6
    signal DM_A7   ~ pin A7
    signal SBU1    ~ pin A8
    signal VBUS_A9 ~ pin A9
    signal GND_A12 ~ pin A12
    signal GND_B1  ~ pin B1
    signal VBUS_B4 ~ pin B4
    signal CC2     ~ pin B5
    signal DP_B6   ~ pin B6
    signal DM_B7   ~ pin B7
    signal SBU2    ~ pin B8
    signal VBUS_B9 ~ pin B9
    signal GND_B12 ~ pin B12
    signal SHIELD  ~ pin SH

component TPD4E05U06:
    # 4-channel ESD array for the USB data and CC lines.
    #
    # USON-10, NOT SOT-23-6 -- I had this wrong. The TPD4E05U06DQA is a
    # 2.5 x 1.0 mm USON-10. The pin names below read oddly here only because
    # the part is sold for USB 3.0 pairs; they are four independent clamps.
    #
    # Pin numbers confirmed against TI table 4-2 in SLVSBO7O (rev. August
    # 2024): D1+ 1, D1- 2, GND 3, D2+ 4, D2- 5, GND 8, and 6/7/9/10 are the
    # no-connects TI puts there for straight-through routing.
    #
    # The land is TI's own rather than KiCad's generic USON-10, because TI
    # draws pins 3 and 8 -- the grounds -- wider than the other eight. On an
    # ESD part the ground return is the whole point of the part working.
    footprint = "hp42s:TI_DQA0010A_USON-10_2.5x1mm_P0.5mm"
    designator_prefix = "U"
    value = "TPD4E05U06DQA"
    signal ch1 ~ pin 1      # D1+
    signal ch2 ~ pin 2      # D1-
    signal ch3 ~ pin 4      # D2+
    signal ch4 ~ pin 5      # D2-
    signal GND1 ~ pin 3
    signal GND2 ~ pin 8
    # Pins 6, 7, 9, 10 are no-connects on this part.

component Battery:
    # LiPo cell, 6 x 45 x 55 mm, ~1600 mAh. It was a 5 x 50 x 60 until the
    # single-sided assembly on 24 September 2026 pushed the bay in; same
    # capacity, one millimetre thicker. See docs/top-edge.md.
    #
    # S2B-PH-SM4-TB, not the B2B vertical it started as. Two reasons, both
    # Barnaby's, 23 September 2026. The vertical one takes the plug from
    # above, and the plug plus its leads need more headroom than the cell
    # beside it is tall. And its through-holes went straight through the
    # board into the SW3 dome site on the front. The SM4-TB is side entry
    # and fully surface mount: nothing pierces the board, and the leads
    # leave it flat.
    footprint = "Connector_JST:JST_PH_S2B-PH-SM4-TB_1x02-1MP_P2.00mm_Horizontal"
    designator_prefix = "BT"
    value = "LiPo 1600 mAh"
    signal p ~ pin 1
    signal n ~ pin 2


# --- e-paper booster -------------------------------------------------------
# These four parts exist only to serve the panel. Values and part numbers are
# Good Display's own, from the GDEY0266T90 specification (24.12.03), page 28,
# not from a generic SSD1680 application note. See docs/epaper-drive.md.

component SchottkyDiode:
    # Three of these in the panel's charge pump. Solomon Systech's own
    # component list for the SSD1680 (table 13-1) names the MBR0530 and then
    # states what actually matters, which is what a replacement has to meet:
    #
    #   reverse DC voltage  >= 30 V
    #   Io                  >= 500 mA
    #   forward voltage     <= 430 mV
    #
    # The MBR0530 is discontinued. 1N5819HW is the easy substitute: 40 V,
    # 1 A, same SOD-123 outline, stocked everywhere. Its 430 mV limit is met
    # comfortably at the current this pump actually draws, which is tens of
    # mA rather than the 500 mA the table sizes for.
    #
    # If you would rather have lower reverse leakage -- worth having, since
    # this is a charge pump holding a rail rather than a supply, and Schottky
    # leakage is what drains it between refreshes -- Nexperia's PMEG family
    # is the better class of part. Send me the datasheet for whichever PMEG
    # your supplier stocks in SOD-123 and I will check it and swap it in.
    #
    # For assembly at JLCPCB this is the CJ B5819W (marked SL), their Basic
    # part in the same SOD-123: 40 V, 1 A, 1 mA leakage at 40 V like the
    # 1N5819HW, so the same argument holds. Either fits this land.
    #
    # Pad 1 is the cathode.
    footprint = "Diode_SMD:D_SOD-123"
    designator_prefix = "D"
    value = "B5819W"
    signal cathode ~ pin 1
    signal anode ~ pin 2

component BoostFET:
    # Si1308EDL, confirmed from Vishay document 63399 rev C. 30 V, Rds(on)
    # 0.185 Ohm max at Vgs = 2.5 V, and the package is SOT-323 / SC-70
    # three lead -- NOT the SC-75A / SOT-416 this was drawn as, which is a
    # smaller body and the wrong land pattern.
    #
    # Solomon Systech ask for BVdss >= 30 V and Rds(on) <= 2.1 Ohm at
    # Vgs = 2.5 V for this position. The Si1308EDL is inside both by a
    # wide margin. The low gate threshold is the point -- the panel drives
    # this gate from its own 3.3 V logic, so a 2N7002 will not do.
    #
    # Pin order from the datasheet's top view: 1 gate, 2 source, 3 drain.
    footprint = "Package_TO_SOT_SMD:SOT-323_SC-70"
    designator_prefix = "Q"
    value = "Si1308EDL"
    signal gate ~ pin 1
    signal source ~ pin 2
    signal drain ~ pin 3

component BoostInductor:
    # 47 uH for the panel's boost. Bourns SRN4018-470M: 47 uH +/-20%, 600 mA,
    # semi-shielded, 4.0 x 4.0 x 1.8 mm.
    #
    # THIS FOOTPRINT USED TO BE A STAND-IN and is not one any more, which
    # closes the oldest open item on the board. Solomon Systech name a Sumida
    # CDRH2D18 or an LDNP-470NC (SSD1680 table 13-1) and what they actually
    # require is 47 uH at Io >= 500 mA. The CDRH2D18 is 3.2 x 3.2 x 2.0 and
    # the pattern this sat on was 3.0 x 3.0 x 1.5 -- close, not the same, and
    # inside the one switching loop on this board where a millimetre of
    # inductance matters.
    #
    # Rather than keep hunting the Sumida drawing, this is now a part whose
    # land pattern is already in KiCad drawn from the vendor's own document.
    # It beats the requirement (600 mA against 500), it is stocked by the
    # usual distributors with a real datasheet, and at 1.8 mm it is 0.2 mm
    # SHORTER than the Sumida -- which is worth having, because it lives on
    # the back where the cell now does too.
    #
    # It costs 0.8 mm in each direction of board area. In a switching loop
    # that is a mild negative; a correct land pattern that is 0.8 mm bigger
    # beats a wrong one that is 0.2 mm smaller.
    footprint = "Inductor_SMD:L_Bourns-SRN4018"
    designator_prefix = "L"
    value = "47u SRN4018-470M"
    signal p1 ~ pin 1
    signal p2 ~ pin 2


component CapBoost:
    # 0603, X5R/X7R, 25 V rating. The rating is not optional: VGH sits near
    # +22 V and VGL near -20 V, and a 16 V part there dies.
    footprint = "Capacitor_SMD:C_0603_1608Metric"
    designator_prefix = "C"
    value = "?"
    signal p1 ~ pin 1
    signal p2 ~ pin 2


# --- top-edge controls -----------------------------------------------------
# Both of these are SIDE-actuated: the knob and the plunger come out of the
# end of the body, in the plane of the board, so they poke through the top
# edge of the case rather than through its front or back. That is the whole
# reason for these two particular parts -- an ordinary top-actuated slide
# switch or tact switch cannot reach a case edge at all.
# Both mount on the FRONT of the board, above the panel -- they moved there
# with the 14 mm bezel on 21 September 2026. See docs/top-edge.md.

# NOT USED SINCE 24 September 2026. The power slider is gone -- on/off is the
# EXIT/ON key now, the way it is on a real 42S, and docs/power-control.md has
# how. The component is kept because the land pattern and the part number are
# the expensive part of this block and nothing is saved by deleting them; it is
# simply not instantiated anywhere. Nothing in the netlist refers to it.
component SlideSwitch:
    # C&K JS102011SAQN, SPDT, ON-ON, side-actuated, gull-wing SMD with two
    # 0.9 mm locating bosses. 9.0 x 3.6 x 3.5 mm body, 0.3 A at 6 V DC.
    #
    # THIS WAS A SHOUHAN MSK-12C02 until 22 September 2026. Two reasons it
    # changed, and the first is the real one:
    #
    #  - KiCad's Shouhan land put the three pads at x = -2.25, +0.75, +2.25,
    #    an uneven 3.0 / 1.5 mm spacing that looks wrong for a part sold as
    #    1.5 mm pitch, and the vendor drawing is behind a host this session
    #    cannot reach. The C&K land is a clean 2.5 mm pitch, three 1.25 x 2.5
    #    pads at x = -2.5, 0, +2.5, drawn from C&K's own document.
    #  - It is the better switch: a proper detent on the control you touch
    #    every day, and a datasheet rather than a marketplace listing.
    #
    # It costs board area. The courtyard is 10.00 x 8.75 mm against the
    # Shouhan's 8.90 x 5.95, so it only became possible when the top bezel
    # went to 14 mm and left 12 mm of board above the panel. At the placement
    # in tools/place_keypad.py it reaches 7.50 mm in, which clears.
    #
    # NO SHIELD PAD. The Shouhan footprint had an "SH" pad and this one does
    # not -- the two bosses are non-plated holes. power.ato lost its
    # sw_power.shield connection with the swap.
    #
    # Pin 2 is the centre terminal and on every conventional SPDT slide
    # switch that is the common. It is still wired so that it does not matter
    # -- see the long comment in power.ato -- because C&K's drawing is on a
    # host this session cannot reach either, and getting it wrong shorts SYS
    # to ground through the switch.
    footprint = "Button_Switch_SMD:SW_SPDT_CK_JS102011SAQN"
    designator_prefix = "SW"
    value = "JS102011SAQN SPDT"
    signal a      ~ pin 1
    signal common ~ pin 2
    signal b      ~ pin 3

component TactSwitchSide:
    # Alps SKRTLAE010, side-actuated SMD tact. Body 4.5 x 2.56 mm with the
    # plunger 0.84 mm proud of it, so 4.5 x 3.4 overall, 3.3 tall.
    #
    # Checked against the Alps catalogue land pattern, page 250. KiCad's
    # SW_Push_1P1T-MP_NO_Horizontal_Alps_SKRTLAE010 reproduces it to the
    # micron -- all seven pads compared -- but leaves out the 2.0 x 1.2 mm
    # rectangle Alps marks "Prohibitted area of copper tracks" between the two
    # mounting pads. A ground pour would fill that silently, so the footprint
    # here is ours with the keepout in it. Pads are KiCad's, unchanged.
    #
    # The part is the -LAE010, the variant WITH guide bosses, so the board
    # needs the two 0.9 mm non-plated holes as well as the pads. The
    # SKRTLBE010 is the same switch without them if the holes ever become a
    # problem.
    #
    # Alps' own circuit diagram commons terminals 1 and 3 inside the switch
    # and puts the contact between that pair and terminal 2. So pad 1 is both
    # outer terminals and pad 2 is the middle one -- a is one side of the
    # contact, b the other. MP is the ground terminal and carries no signal,
    # so it goes to ground for strength.
    #
    # From the catalogue and the KRT-701 specification:
    #
    #   1.6 N operating force -- stiff, about ten times a keypad dome
    #   0.2 +0.2/-0.1 mm travel
    #   10 ms bounce new, 20 ms after 100,000 operations
    #   50 mA 12 V DC maximum, 10 uA 1 V DC minimum, 100,000 cycle life
    #   500 mOhm initial contact resistance
    #   reflow only: the SKRT series is absent from Alps' hand-soldering
    #   table, and flux wicks in from the top face
    #   3,000 per reel, minimum order 3,000
    #
    # The 20 ms sets the debounce in firmware. The 1.6 N is why these two are
    # recessed buttons on the top edge and not keys.
    footprint = "hp42s:Alps_SKRTLAE010_SidePush"
    designator_prefix = "SW"
    value = "SKRTLAE010"
    signal a  ~ pin 1
    signal b  ~ pin 2
    signal mp ~ pin MP

# --- MCU, display, sound ---------------------------------------------------

component ESP32S3WROOM1:
    # ESP32-S3-WROOM-1-N16R2: 16 MB flash, 2 MB QUAD PSRAM, LCSC C2913205.
    # Replaced the MINI-1-N8 on 2 October 2026 for room to grow (Python,
    # extra apps). 18 x 25.5 x 3.1 mm.
    #
    # QUAD PSRAM matters, as no-PSRAM did on the MINI: an -R8/-R16V octal
    # part takes IO35-IO37, which carry the panel and storage bus.
    #
    # PIN NUMBERS: checked one by one against table 2-1 ("Pin Definitions")
    # of the ESP32-S3-WROOM-1/1U datasheet v1.3. 41 pads: 1, 40 and the
    # exposed pad 41 are ground. IO26, IO33 and IO34 are NOT brought out.
    #
    # Footprint: KiCad 10's RF_Module ESP32-S3-WROOM-1, copied into hp42s
    # with its twelve thermal vias taken out of pad 41 -- they would come
    # through to the front under the bottom key row's domes. Ground vias are
    # placed by tools/stitch_zones.py where they fit instead. Its antenna
    # keepout zone (48 x 21 mm) is kept as KiCad drew it.
    #
    # ANTENNA: as on the MINI, the antenna end sits at the bottom board edge
    # with no copper under it on any layer.
    footprint = "hp42s:ESP32-S3-WROOM-1"
    designator_prefix = "U"
    value = "ESP32-S3-WROOM-1-N16R2"
    signal GND1   ~ pin 1
    signal V3P3   ~ pin 2
    signal EN     ~ pin 3
    signal IO4    ~ pin 4
    signal IO5    ~ pin 5
    signal IO6    ~ pin 6
    signal IO7    ~ pin 7
    signal IO15   ~ pin 8
    signal IO16   ~ pin 9
    signal IO17   ~ pin 10
    signal IO18   ~ pin 11
    signal IO8    ~ pin 12
    signal USB_DM ~ pin 13
    signal USB_DP ~ pin 14
    signal IO3    ~ pin 15
    signal IO46   ~ pin 16
    signal IO9    ~ pin 17
    signal IO10   ~ pin 18
    signal IO11   ~ pin 19
    signal IO12   ~ pin 20
    signal IO13   ~ pin 21
    signal IO14   ~ pin 22
    signal IO21   ~ pin 23
    signal IO47   ~ pin 24
    signal IO48   ~ pin 25
    signal IO45   ~ pin 26
    signal IO0    ~ pin 27
    signal IO35   ~ pin 28
    signal IO36   ~ pin 29
    signal IO37   ~ pin 30
    signal IO38   ~ pin 31
    signal IO39   ~ pin 32
    signal IO40   ~ pin 33
    signal IO41   ~ pin 34
    signal IO42   ~ pin 35
    signal IO44   ~ pin 36
    signal IO43   ~ pin 37
    signal IO2    ~ pin 38
    signal IO1    ~ pin 39
    signal GND40  ~ pin 40
    signal GND41  ~ pin 41

component SPINAND:
    # 2 Gbit SLC SPI NAND, 3.3 V, 8 x 6 mm U-PDFN-8 / WSON-8, 1.27 mm pitch.
    # Micron MT29F2G01ABAGDWB-IT (LCSC C410863); Winbond W25N02KVZEIR fits
    # the same land. Pinout is the same on both (Micron datasheet figure 2,
    # Winbond figure 1b, top view). Pad 9 is the Winbond's exposed pad,
    # "not connected internally", grounded here and unpasted; the Micron
    # has no metal there.
    footprint = "hp42s:SPI_NAND_UPDFN-8_8x6mm_P1.27mm"
    designator_prefix = "U"
    value = "MT29F2G01ABAGDWB-IT"
    signal CS   ~ pin 1
    signal SO   ~ pin 2
    signal WP   ~ pin 3
    signal VSS  ~ pin 4
    signal SI   ~ pin 5
    signal SCK  ~ pin 6
    signal HOLD ~ pin 7
    signal VCC  ~ pin 8
    signal EP   ~ pin 9

component EPDConnector:
    # 24-pin 0.5 mm FPC, TOP CONTACT, for the 2.66 inch SSD1680 panel.
    # The panel mounts on the FRONT of the board and the tail folds around the
    # left board edge to this connector on the BACK, so its height stays out
    # of the front stack-up.
    #
    # Pin NUMBERS here, from the panel specification page 28. This is the one
    # part in the file where the numbering is certain, so it is written down:
    # the tail is a plain 24-way 0.5 mm flex and pad 1 of the connector really
    # is panel pin 1.
    #
    # TOP CONTACT, and that is not a preference. The panel's contacts are on
    # its VIEWING face -- the datasheet's side view marks the contact side on
    # the front face, and Barnaby confirmed it on the physical panel on
    # 23 September 2026: laid face up, the gold fingers are on top. The panel
    # is on the front of the board with its viewing face pointing away from
    # the board, so the contacts point away from the board too; the half-turn
    # around the left edge carries that through, and on the back they face
    # away from the board again. A bottom-contact part clamps the flex's
    # BOARD-facing side, so it would be holding the bare backing. This
    # started as a Hirose FH12-24S-0.5SH, which is bottom contact, and that
    # was wrong.
    #
    # Amphenol F32Q-1A7H1-11024. Top contact, 0.5 mm pitch, 24 way, 2.00 mm
    # high, 0.5 A, right angle SMT ZIF -- the same height as the FH12 it
    # replaces and 1.2 mm shorter front to back. The F32R is the same shell
    # with bottom contacts, so order the Q.
    footprint = "Connector_FFC-FPC:Amphenol_F32Q-1A7x1-11024_1x24-1MP_P0.5mm_Horizontal"
    designator_prefix = "J"
    value = "EPD FPC 24way top contact"
    signal NC1   ~ pin 1
    signal GDR   ~ pin 2
    signal RESE  ~ pin 3
    signal NC4   ~ pin 4
    signal VSH2  ~ pin 5
    signal TSCL  ~ pin 6
    signal TSDA  ~ pin 7
    signal BS    ~ pin 8
    signal BUSY  ~ pin 9
    signal RES   ~ pin 10
    signal DC    ~ pin 11
    signal CS    ~ pin 12
    signal SCL   ~ pin 13
    signal SDA   ~ pin 14
    signal VDDIO ~ pin 15
    signal VCI   ~ pin 16
    signal VSS   ~ pin 17
    signal VDD   ~ pin 18
    signal VPP   ~ pin 19
    signal VSH1  ~ pin 20
    signal VGH   ~ pin 21
    signal VSL   ~ pin 22
    signal VGL   ~ pin 23
    signal VCOM  ~ pin 24

    # The two metal fittings. KiCad gives them both the pad name "MP", so one
    # signal reaches both, and tying them to ground is the usual practice:
    # they are what holds a 24-way ZIF down when the flex is folded against
    # it, and a grounded hold-down is one less isolated copper island under a
    # part the user will flex on assembly.
    signal MP ~ pin MP

component StatusLED:
    # CHANGED 5 October 2026 to the XINGLIGHT XL-C4040SURSYGC (LCSC C7545693),
    # because Barnaby wanted the lens in line with the USB mouth and the two
    # buttons: its lens centre is 2.0 mm above the board (the LTST-S326's
    # was 0.5), against 1.28 for USB and 1.65 for the buttons, and the case
    # wall's centreline at 1.7 on the back. Same colours, red 625 nm and
    # yellow-green 570 nm, 800 mcd at 20 mA.
    #
    # Its two dice are BACK TO BACK between two terminals, so there is no
    # common anode any more: drive one terminal high and the other low.
    # t_red is the red die's anode (pins 1 and 3), t_green the yellow-green
    # die's anode (pins 2 and 4). Both pins high impedance at reset is still
    # dark. Amber is the two alternated quickly.
    footprint = "hp42s:XINGLIGHT_XL-C4040_SideView"
    designator_prefix = "D"
    value = "XL-C4040SURSYGC red/green"
    signal t_red   ~ pin 1
    t_red ~ pin 3
    signal t_green ~ pin 2
    t_green ~ pin 4

component Buzzer:
    # Murata PKLCS1212E4001-R1, 12 x 12 x 3.0 mm, 4 kHz.
    #
    # This is a PIEZOELECTRIC sounder, not a magnetic transducer: a ~10 nF
    # capacitor with a disc on it, not a coil. It was wired as a coil here
    # until the Murata specification (JGB40-1584B) arrived, which is why the
    # drive circuit in hp42s.ato changed with it.
    #
    # 75 dB minimum at 10 cm on +/-1.5 Vo-p of 4 kHz square wave, so a 3.3 V
    # GPIO swing gets the rated level and a little over. Maximum input is
    # +/-12.5 Vo-p, and Murata says never to leave DC across it.
    #
    # Land pattern is Murata's own: two 1.2 x 4.0 mm pads, inner edges 10.0
    # apart, outer edges 12.4. KiCad's Buzzer_Murata_PKLCS1212E is exactly
    # that, checked pad by pad, so it stays.
    #
    # Not sealed. It cannot be washed, so it goes on last if the board is
    # cleaned after assembly.
    footprint = "Buzzer_Beeper:Buzzer_Murata_PKLCS1212E"
    designator_prefix = "LS"
    value = "PKLCS1212E4001-R1 piezo"
    signal p ~ pin 1
    signal n ~ pin 2

component IRLED:
    # HP-82240 infrared printing, 940 nm.
    # SIDE-EMITTING, so the beam leaves through the top edge of the case the
    # way the original 42S's does. A top-emitting 0805 would fire straight up
    # into the back shell, which is what this was before.
    #
    # Vishay VSMB2943SLX01, confirmed side-looking from its own datasheet
    # (document 83479 rev 1.2): 2.3 x 2.55 x 2.3 mm, +/- 25 degrees half
    # angle, 20 mW/sr, 1.35 V typical at 100 mA. The land pattern is Vishay's
    # own IPC 7351 proposal, generated by tools/gen_ic_footprints.py -- two
    # 0.9 x 1.2 mm pads 4.2 mm across the outsides. It replaces the 1.6 x
    # 0.6 mm Kingbright pattern that was standing in for it, which was less
    # than half the size.
    #
    # The optical axis sits 1.2 mm above the face of the board it is soldered
    # to. The part is on the BACK, so the beam runs 1.2 mm behind the back
    # copper: that is where the window in the top edge of the case goes.
    #
    # The alternative, if range disappoints: a through-hole 3 mm IR LED lying
    # on its side with the leads bent, aimed at the top edge. Far more output
    # and a tighter beam, at the cost of one hand-fitted part and about 6 mm
    # of board depth. The HP-82240B is not fussy about either.
    #
    # Pad 1 is the cathode -- the left lead LOOKING INTO the lens, per the
    # front view on page 5 of the datasheet. Getting it backwards costs
    # nothing but a dark LED: 5 V reverse rating against our 3.3 V drive.
    footprint = "hp42s:Vishay_VSMB2943SLX01_SideView"
    designator_prefix = "D"
    value = "VSMB2943SLX01 940nm side-view"
    signal cathode ~ pin 1
    signal anode ~ pin 2

# --- frontlight ------------------------------------------------------------
# Optional. Neither of these is fitted on a unit without a light guide, which
# is why their standing current is allowed to be non-zero. See
# docs/front-face.md.

component FrontlightLED:
    # Dialight 599-2Q01-147F. White InGaN behind a yellow diffused lens,
    # 1208 right angle, 3.0 x 2.0 x 1.0 mm, 90/200/320 mcd at 20 mA, 130
    # degree viewing angle, Vf 2.9/3.4/3.7 V.
    #
    # The forward voltage is the number that shaped the whole circuit. At
    # 3.4 V typical there is no headroom left on a half-empty cell, so these
    # cannot be ballasted off SYS the way the status LED is off 3V3 -- hence
    # the boost. See docs/front-face.md.
    #
    # 130 degrees sounds far too wide for edge injection and is not: light
    # entering acrylic from air is refracted into a cone of +/- 42 degrees
    # however wide it arrives, and all of that totally-internally-reflects.
    # Wide mixes faster and shortens the hot-spot zone at the injection edge.
    #
    # SAME PACKAGE AS THE STATUS LED, DIFFERENT PIN NUMBERS. On the
    # bi-colour part the left pad is 3 and the right is 2; on this one the
    # left pad is 2 and the right is 1, and pad 3 is a mechanical anchor with
    # nothing bonded to it. That is why it has its own footprint. Pin 1 is
    # the cathode, from the LED schematic and cathode mark on page 1 of the
    # 599 RA Single-Color 1208 datasheet.
    #
    # These do not go on the main board. They sit on a 1.0 mm FR4 sliver that
    # lies on it, because the light guide's edge is 1.1 mm higher than a part
    # soldered flat would emit.
    footprint = "hp42s:Dialight_599_White_1208_RA"
    designator_prefix = "D"
    value = "599-2Q01-147F white"
    signal cathode ~ pin 1
    signal anode ~ pin 2
    signal nc ~ pin 3

component TPS61165:
    # Single-string white LED driver, SOT-23-6 (DBV). 3 to 18 V in, up to
    # 38 V out, 1.2 MHz, 200 mV feedback reference at 2 percent, PWM or
    # EasyScale dimming on CTRL, open-LED protection.
    #
    # Four LEDs in series want about 13.6 V out of a 3.0 to 4.2 V cell, which
    # is what forces a boost. Series also collapses four ballast resistors
    # into one current-set resistor and holds the current constant all the
    # way down the discharge, so nothing in firmware has to compensate.
    #
    # Open-LED protection earns its keep here more than usual: the LEDs are
    # on a separate sliver at the end of two soldered wires.
    #
    # PIN NUMBERS CONFIRMED 22 September 2026 against the pin functions table
    # in section 6 of SLVS790E (revised April 2019), from the PDF Barnaby
    # supplied. The table gives WSON and SOT-23 numbering side by side; these
    # are the SOT-23 column. KiCad's SOT-23-6 pads are called 1..6, so these
    # are numbers, not names.
    footprint = "Package_TO_SOT_SMD:SOT-23-6"
    designator_prefix = "U"
    value = "TPS61165DBVR"
    signal VIN  ~ pin 1
    signal CTRL ~ pin 2
    signal SW   ~ pin 3
    signal GND  ~ pin 4
    signal COMP ~ pin 5
    signal FB   ~ pin 6

component FrontlightInductor:
    # 22 uH, 3.0 x 3.0 x 1.5 mm shielded, e.g. Taiyo Yuden NR3015T220M:
    # 0.53 A saturation, about 0.45 Ohm DCR. L_APV_ANR3015 is the 3015 land
    # pattern and fits it.
    #
    # 22 uH IS TI'S OWN OPTIMUM, confirmed against SLVS790E section 9.1.2:
    # "a 10-uH to 22-uH inductor value range is recommended. A 22-uH inductor
    # optimized the efficiency for most application while maintaining low
    # inductor peak to peak ripple." The same section says not to go below
    # 10 uH -- the part's built-in slope compensation stops being adequate
    # and the loop can go unstable -- so this is a floor, not a preference.
    footprint = "Inductor_SMD:L_APV_ANR3015"
    designator_prefix = "L"
    value = "22u NR3015T220M"
    signal p1 ~ pin 1
    signal p2 ~ pin 2


# --- the MIP panel (branch `mip` only) --------------------------------------

component MIPConnector:
    # Hirose FH34SRJ-10S-0.5SH(50), JLC C324723. Sharp's first recommendation
    # for the LS032B7DD02 (its table 8-2-1), 10 way at 0.5 mm, and also right
    # for the LS027B7DH01 on branch ls027: same 10 pins in the same order
    # (LD-28305A table 4-1), and its 0.5 pitch, 0.3 thick FPC. On ls027 the
    # tail folds BACK through a board slot under the glass, so the paragraph
    # below about the left-edge fold is the mip arrangement. Sharp's LS027
    # drawing does not mark pin 1; check the panel's own FPC before fitting. contacts top
    # AND bottom, so it does not matter which face of the flex arrives on
    # top after the fold. Land from the FH34 catalogue: see
    # tools/gen_ic_footprints.py.
    #
    # Connector pin n IS panel pin n, and that follows from the fold. Sharp's
    # outline drawing (page 60) is third-angle: the side view puts the
    # stiffener on the rear face, the view above it therefore looks at the
    # front, and its detail A has pin 1 on the left with the tail pointing
    # down. Turned so the tail leaves to the left of the board, pin 1 is at
    # the TOP (low board Y). The fold is about the vertical left edge, which
    # keeps Y, so pin 1 is still at the top on the back. J2 sits there at
    # 90 degrees, mouth facing -X, and at 90 its pad 1 is the low-Y end.
    footprint = "hp42s:Hirose_FH34SRJ-10S-0.5SH_1x10-1MP_P0.50mm_Horizontal"
    designator_prefix = "J"
    value = "FH34SRJ-10S-0.5SH"
    signal SCLK     ~ pin 1
    signal SI       ~ pin 2
    signal SCS      ~ pin 3
    signal EXTCOMIN ~ pin 4
    signal DISP     ~ pin 5
    signal VDDA     ~ pin 6
    signal VDD      ~ pin 7
    signal EXTMODE  ~ pin 8
    signal VSS      ~ pin 9
    signal VSSA     ~ pin 10
    signal MP ~ pin MP

component TPS610997:
    # TI TPS610997YFFR, JLC C2072359: synchronous boost, fixed 5.0 V out,
    # 1 uA quiescent, true disconnect when EN is low. DSBGA-6 at 0.4 mm.
    # Ball names from table 5-1 of SLVSD88M; FB goes to GND on the fixed
    # versions.
    footprint = "hp42s:TI_YFF0006_DSBGA-6_0.88x1.23mm_P0.4mm"
    designator_prefix = "U"
    value = "TPS610997YFFR"
    signal VIN  ~ pin A1
    signal SW   ~ pin B1
    signal EN   ~ pin C1
    signal GND  ~ pin A2
    signal VOUT ~ pin B2
    signal FB   ~ pin C2

component RV8263C7:
    # Micro Crystal RV-8263-C7, JLC C5137460: I2C real-time clock with its
    # crystal inside, 190 nA, CLKOUT programmable from 32.768 kHz down to
    # 1 Hz. Pins from the datasheet's pin table; pin 1 is not connected.
    footprint = "hp42s:MicroCrystal_C7_3.2x1.5mm_RV-8263"
    designator_prefix = "U"
    value = "RV-8263-C7"
    signal NC     ~ pin 1
    signal VSS    ~ pin 2
    signal CLKOE  ~ pin 3
    signal INT    ~ pin 4
    signal VDD    ~ pin 5
    signal CLKOUT ~ pin 6
    signal SCL    ~ pin 7
    signal SDA    ~ pin 8

component MIPBoostInductor:
    # 2.2 uH, which TI recommends above 3 V out (SLVSD88M 8.2.2.4). Murata
    # DFE201612P-2R2M, JLC C79317: 2.0 x 1.6 x 1.2 mm, 1.5 A, 144 mOhm --
    # the panel draws microamps, so the DCR costs nothing. KiCad's
    # DFE201610P land is the same 2016 footprint, 0.2 mm lower.
    footprint = "Inductor_SMD:L_Murata_DFE201610P"
    designator_prefix = "L"
    value = "2u2 DFE201612P-2R2M"
    signal p1 ~ pin 1
    signal p2 ~ pin 2

component LSM6DSV16X:
    # ST LSM6DSV16X, 6-axis IMU (accelerometer + gyroscope), JLC C5267406.
    # LGA-14L 3.0 x 2.5 x 0.86 mm. Pins from table 2 of DS13510 rev 4.
    # On I2C: CS high selects I2C, SDO/SA0 low gives address 0x6A. SDx/SCx
    # (pins 2 and 3) go to GND with the analog hub and Qvar unused; OCS_Aux
    # and SDO_Aux (10, 11) are left unconnected but soldered, as ST says.
    footprint = "hp42s:ST_LGA-14L_3x2.5mm_P0.5mm"
    designator_prefix = "U"
    value = "LSM6DSV16XTR"
    signal SA0     ~ pin 1
    signal SDX     ~ pin 2
    signal SCX     ~ pin 3
    signal INT1    ~ pin 4
    signal VDDIO   ~ pin 5
    signal GND1    ~ pin 6
    signal GND2    ~ pin 7
    signal VDD     ~ pin 8
    signal INT2    ~ pin 9
    signal OCS_AUX ~ pin 10
    signal SDO_AUX ~ pin 11
    signal CS      ~ pin 12
    signal SCL     ~ pin 13
    signal SDA     ~ pin 14

component LIS2MDL:
    # ST LIS2MDL, 3-axis magnetometer, JLC C919695. LGA-12 2.0 x 2.0 x 0.7 mm.
    # Pins from table 2 of DocID030621 rev 5. Fixed I2C address 0x1E. C1 is
    # the set/reset pulse capacitor: 220 nF, low ESR, right against pins 5/6.
    footprint = "hp42s:ST_LGA-12_2x2mm_P0.5mm"
    designator_prefix = "U"
    value = "LIS2MDLTR"
    signal SCL   ~ pin 1
    signal NC2   ~ pin 2
    signal CS    ~ pin 3
    signal SDA   ~ pin 4
    signal C1    ~ pin 5
    signal GND6  ~ pin 6
    signal INT   ~ pin 7
    signal GND8  ~ pin 8
    signal VDD   ~ pin 9
    signal VDDIO ~ pin 10
    signal NC11  ~ pin 11
    signal NC12  ~ pin 12

component FrontlightFPC:
    # Azumo 11103-06 front light's LED flex: 2.49 mm wide, two contacts 0.8
    # wide at 1.0 pitch on its last 3.32 mm, stiffened there to 0.30 mm
    # (Azumo drawing 11103-06 T7 detail A; thickness from Azumo's STEP), a
    # standard 1.0 mm ZIF tail. Lying along the back of the board its
    # contacts face AWAY from the board, so a TOP-contact connector on the
    # back. The connector's slot is for a 3.0 mm tail, so the 2.49 mm one has
    # 0.3 mm of side play; the 0.8 mm fingers still land on 1.0 mm-pitch
    # contacts. Polarity: + is the contact nearer the short glass edge the
    # flex leaves beside (Azumo detail A), board +X here. Fitted only on
    # boards built with the front light.
    footprint = "hp42s:FPC_1.0mm_2P_TopContact_1.0K-LS"
    designator_prefix = "J"
    value = "1.0K-LS-2PWB-TW"
    signal anode   ~ pin 1
    signal cathode ~ pin 2
    signal mp      ~ pin MP
