# ---------------------------------------------------------------------------
# parts.ato -- component declarations for the HP-42S clone.
#
# PIN NAMES, NOT PIN NUMBERS.
#
# Every IC below declares its pins by the name the datasheet uses (IN, SYS,
# BAT, ...) rather than by number. atopile is happy with either; names are
# used deliberately, because inventing pin numbers from memory is exactly the
# error that costs a board spin. When these parts are given real KiCad
# symbols, the names here have to be reconciled with the symbol's numbering.
# Until then the netlist is correct about *what connects to what* and silent
# about which physical pin that is.
#
# Footprint strings are unchecked: atopile passes them through to the netlist
# verbatim and never looks for the file. KiCad checks them at import, so every
# one below is library-qualified and was looked up in KiCad's own footprint
# library rather than guessed. Three exceptions, all marked TODO below:
# `hp42s:` is this repo's own library (elec/footprints/hp42s.pretty), which at
# the moment holds the two dome sites and nothing else. See docs/kicad-setup.md.
# ---------------------------------------------------------------------------

# NO `designator` IN THESE BODIES. Instances set their own (keypad.ato gives
# every key the core's key number, so SW19 is the `7` key). Two dead ends got
# us here: a placeholder like `designator = "R?"` in a component body is taken
# as a real designator and the second instance fails with "Designator R?
# already in use"; and the type-annotation form `designator: string` parses
# locally but is rejected by atopile's newer parser -- "expected name, got
# 'string'". Assigning per instance works in both.

# --- passives --------------------------------------------------------------

component Resistor:
    footprint = "Resistor_SMD:R_0402_1005Metric"
    designator_prefix = "R"
    value = "?"
    signal p1 ~ pin 1
    signal p2 ~ pin 2

component Capacitor:
    footprint = "Capacitor_SMD:C_0402_1005Metric"
    designator_prefix = "C"
    value = "?"
    signal p1 ~ pin 1
    signal p2 ~ pin 2

component Inductor:
    # The buck-boost's 2.2 uH. Coilcraft XFL4020-222ME, from TI's own
    # recommended list (TPS63900 table 8-2): 3.5 A saturation, 21 mOhm,
    # 4 x 4 x 2 mm. The other four on TI's list are smaller and four to five
    # times the DC resistance; this board has room on the back and would
    # rather have the efficiency, because battery life is the headline
    # number. KiCad's L_Coilcraft_XxL4020 is the land pattern for it.
    footprint = "Inductor_SMD:L_Coilcraft_XxL4020"
    designator_prefix = "L"
    value = "2u2 XFL4020-222ME"
    signal p1 ~ pin 1
    signal p2 ~ pin 2

component Diode:
    # SOD-323. KiCad numbers diode pads 1 = cathode, 2 = anode (pad 1 is the
    # marked end). Numbers, not names, because this footprint is real and its
    # pads are called 1 and 2 -- a pin called "K" would match no pad at all.
    footprint = "Diode_SMD:D_SOD-323"
    designator_prefix = "D"
    value = "?"
    signal cathode ~ pin 1
    signal anode ~ pin 2

component NFET:
    # 2N7002 small-signal N-channel, SOT-23. Numbered for the same reason as
    # the diode: SOT-23 pads are 1, 2, 3. The 2N7002 pinout is the SOT-23
    # standard, 1 = gate, 2 = source, 3 = drain.
    footprint = "Package_TO_SOT_SMD:SOT-23"
    designator_prefix = "Q"
    value = "2N7002"
    signal gate ~ pin 1
    signal source ~ pin 2
    signal drain ~ pin 3

component TestPad:
    footprint = "TestPoint:TestPoint_Pad_D1.5mm"
    designator_prefix = "TP"
    value = "test pad"
    signal p ~ pin 1

# --- keypad ----------------------------------------------------------------

component DomeKey10:
    # Snaptron F10260: 10 mm, 260 gf. Digits and operators.
    # Pad 1 is the outer ring, pad 2 the centre -- see tools/gen_dome_footprints.py.
    footprint = "hp42s:Snaptron_F10260_Dome"
    designator_prefix = "SW"
    value = "F10260"
    signal ring ~ pin 1
    signal centre ~ pin 2

component DomeKey85:
    # Snaptron F08210: 8.5 mm, 210 gf. Function rows and ENTER.
    footprint = "hp42s:Snaptron_F08210_Dome"
    designator_prefix = "SW"
    value = "F08210"
    signal ring ~ pin 1
    signal centre ~ pin 2

# --- power -----------------------------------------------------------------

component BQ25185:
    # Single-cell linear charger with power path, DLH 10-pin WSON.
    # Pin numbers and names from the datasheet Barnaby supplied
    # (SLUSF65B, table 4-1). Two corrections came out of that reading:
    # there is no "CHG" pin -- status is TWO open-drain pins, STAT1 and
    # STAT2, which between them encode four states -- and ILIM and VSET are
    # one pin, programmed by a single resistor.
    #
    # Footprint: TI's DLH0010A land pattern (drawing 4226298/A) is 0.4 mm
    # pitch with a 1.5 x 0.9 mm thermal pad, which is exactly what KiCad's
    # DSQ0010A footprint provides. Same outline under two TI package codes.
    footprint = "Package_DFN_QFN:Texas_DSQ0010A_WSON-10-1EP_2x2mm_P0.4mm_EP0.9x1.5mm"
    designator_prefix = "U"
    value = "BQ25185"
    signal SYS       ~ pin 1
    signal BAT       ~ pin 2
    signal STAT2     ~ pin 3
    signal CE_N      ~ pin 4
    signal GND       ~ pin 5
    signal TS_MR     ~ pin 6
    signal ILIM_VSET ~ pin 7
    signal ISET      ~ pin 8
    signal STAT1     ~ pin 9
    signal IN        ~ pin 10
    signal PAD       ~ pin 11

component TPS63900:
    # Buck-boost to 3.3 V, 75 nA quiescent. Mandatory: the panel's VCI
    # cannot take a 4.2 V cell directly.
    #
    # There is NO feedback divider on this part -- I had invented one. The
    # output voltage is set by resistors on CFG1/CFG2/CFG3 and chosen
    # between by SEL, and all three CFG pins must not be left open.
    #
    # Package is DSK0010A, a 2.5 x 2.5 mm WSON-10, not the VQFN-12 this
    # entry used to claim. The footprint is generated from TI's own land
    # pattern by tools/gen_ic_footprints.py.
    footprint = "hp42s:TI_DSK0010A_WSON-10-1EP_2.5x2.5mm_P0.5mm_EP2x1.2mm"
    designator_prefix = "U"
    value = "TPS63900DSK"
    signal EN   ~ pin 1
    signal SEL  ~ pin 2
    signal CFG1 ~ pin 3
    signal CFG2 ~ pin 4
    signal CFG3 ~ pin 5
    signal VOUT ~ pin 6
    signal LX2  ~ pin 7
    signal GND  ~ pin 8
    signal LX1  ~ pin 9
    signal VIN  ~ pin 10
    signal PAD  ~ pin 11

component MAX17048:
    # ModelGauge fuel gauge, I2C, no sense resistor. TDFN-8, 2 x 2 mm.
    #
    # The WLP is a 1.2 x 0.9 mm eight-bump wafer-level part and there is no
    # reflowing that by hand. TDFN is the same die in a package you can
    # actually place, and Maxim sells both.
    #
    # CHECK BEFORE FAB: the datasheet points at Maxim land pattern 90-0065
    # rather than drawing it, and that document is not in the PDF. KiCad's
    # generic TDFN-8 2 x 2 mm is almost certainly right -- the package code
    # T822 says 8 pins, 2 x 2 mm -- but the exposed pad size is the part
    # that varies between vendors and it has not been confirmed.
    #
    # On the MAX17048 specifically, VDD is the sense input and goes to the
    # cell; CELL is not internally connected at all. It is the MAX17049,
    # the 2-cell part, that uses CELL. Easy to wire the wrong one.
    footprint = "Package_DFN_QFN:TDFN-8-1EP_2x2mm_P0.5mm_EP0.8x1.2mm"
    designator_prefix = "U"
    value = "MAX17048G+T10"
    signal CTG   ~ pin 1
    signal CELL  ~ pin 2
    signal VDD   ~ pin 3
    signal GND   ~ pin 4
    signal ALRT_N ~ pin 5
    signal QSTRT ~ pin 6
    signal SCL   ~ pin 7
    signal SDA   ~ pin 8
    signal PAD   ~ pin 9

component USBCReceptacle:
    # 16-pin USB-C 2.0 receptacle, HCTL HC-TYPE-C-16P-01A.
    #
    # Pin NAMES here are the USB-C contact names, because that is what the
    # footprint's pads are actually called -- A1, A4, B5 and so on, straight
    # off the connector standard. This is the rare case where the datasheet
    # names and the KiCad pad names are the same thing.
    #
    # The two rows are what make the plug reversible: rotate the plug and A
    # swaps with B. So VBUS is four pads, GND is four pads, and D+/D- are two
    # each and get tied together for USB 2.0. CC1 and CC2 must NOT be tied --
    # they are how the sink tells the source which way round the plug went in.
    # SBU1/SBU2 are for alternate modes and stay unconnected.
    footprint = "Connector_USB:USB_C_Receptacle_HCTL_HC-TYPE-C-16P-01A"
    designator_prefix = "J"
    value = "USB-C 2.0 16P"
    signal GND_A1  ~ pin A1
    signal VBUS_A4 ~ pin A4
    signal CC1     ~ pin A5
    signal DP_A6   ~ pin A6
    signal DM_A7   ~ pin A7
    signal SBU1    ~ pin A8
    signal VBUS_A9 ~ pin A9
    signal GND_A12 ~ pin A12
    signal GND_B1  ~ pin B1
    signal VBUS_B4 ~ pin B4
    signal CC2     ~ pin B5
    signal DP_B6   ~ pin B6
    signal DM_B7   ~ pin B7
    signal SBU2    ~ pin B8
    signal VBUS_B9 ~ pin B9
    signal GND_B12 ~ pin B12
    signal SHIELD  ~ pin SH

component TPD4E05U06:
    # 4-channel ESD array for the USB data and CC lines.
    #
    # USON-10, NOT SOT-23-6 -- I had this wrong. The TPD4E05U06DQA that KiCad
    # carries a symbol for is a 2.5 x 1.0 mm USON-10, and the pin names below
    # are that symbol's (D1+/D1-/D2+/D2-), which read oddly here only because
    # the part is sold for USB 3.0 pairs. They are four independent clamps.
    footprint = "Package_SON:USON-10_2.5x1.0mm_P0.5mm"
    designator_prefix = "U"
    value = "TPD4E05U06DQA"
    signal ch1 ~ pin 1      # D1+
    signal ch2 ~ pin 2      # D1-
    signal ch3 ~ pin 4      # D2+
    signal ch4 ~ pin 5      # D2-
    signal GND1 ~ pin 3
    signal GND2 ~ pin 8
    # Pins 6, 7, 9, 10 are no-connects on this part.

component Battery:
    # LiPo cell, 5 x 50 x 60 mm, ~1650 mAh. Two-pad JST or soldered tabs.
    footprint = "Connector_JST:JST_PH_B2B-PH-K_1x02_P2.00mm_Vertical"
    designator_prefix = "BT"
    value = "LiPo 1650 mAh"
    signal p ~ pin 1
    signal n ~ pin 2


# --- e-paper booster -------------------------------------------------------
# These four parts exist only to serve the panel. Values and part numbers are
# Good Display's own, from the GDEY0266T90 specification (24.12.03), page 28,
# not from a generic SSD1680 application note. See docs/epaper-drive.md.

component SchottkyDiode:
    # Three of these in the panel's charge pump. Solomon Systech's own
    # component list for the SSD1680 (table 13-1) names the MBR0530 and then
    # states what actually matters, which is what a replacement has to meet:
    #
    #   reverse DC voltage  >= 30 V
    #   Io                  >= 500 mA
    #   forward voltage     <= 430 mV
    #
    # The MBR0530 is discontinued. 1N5819HW is the easy substitute: 40 V,
    # 1 A, same SOD-123 outline, stocked everywhere. Its 430 mV limit is met
    # comfortably at the current this pump actually draws, which is tens of
    # mA rather than the 500 mA the table sizes for.
    #
    # If you would rather have lower reverse leakage -- worth having, since
    # this is a charge pump holding a rail rather than a supply, and Schottky
    # leakage is what drains it between refreshes -- Nexperia's PMEG family
    # is the better class of part. Send me the datasheet for whichever PMEG
    # your supplier stocks in SOD-123 and I will check it and swap it in.
    #
    # Pad 1 is the cathode.
    footprint = "Diode_SMD:D_SOD-123"
    designator_prefix = "D"
    value = "1N5819HW"
    signal cathode ~ pin 1
    signal anode ~ pin 2

component BoostFET:
    # Si1308EDL, confirmed from Vishay document 63399 rev C. 30 V, Rds(on)
    # 0.185 Ohm max at Vgs = 2.5 V, and the package is SOT-323 / SC-70
    # three lead -- NOT the SC-75A / SOT-416 this was drawn as, which is a
    # smaller body and the wrong land pattern.
    #
    # Solomon Systech ask for BVdss >= 30 V and Rds(on) <= 2.1 Ohm at
    # Vgs = 2.5 V for this position. The Si1308EDL is inside both by a
    # wide margin. The low gate threshold is the point -- the panel drives
    # this gate from its own 3.3 V logic, so a 2N7002 will not do.
    #
    # Pin order from the datasheet's top view: 1 gate, 2 source, 3 drain.
    footprint = "Package_TO_SOT_SMD:SOT-323_SC-70"
    designator_prefix = "Q"
    value = "Si1308EDL"
    signal gate ~ pin 1
    signal source ~ pin 2
    signal drain ~ pin 3

component BoostInductor:
    # 47 uH for the panel's boost. Solomon Systech name the Sumida CDRH2D18
    # or the LDNP-470NC, both 47 uH at Io = 500 mA max (SSD1680 table 13-1).
    #
    # FOOTPRINT IS A STAND-IN. The CDRH2D18 is a 3.2 x 3.2 x 2.0 mm body and
    # this pattern is 3.0 x 3.0 x 1.5. Close, not the same. Replace it once
    # we have the drawing for whichever of the two is actually buyable, the
    # same way the IR emitter and the status LED were done.
    footprint = "Inductor_SMD:L_APV_ANR3015"
    designator_prefix = "L"
    value = "47u 500mA Sumida CDRH2D18"
    signal p1 ~ pin 1
    signal p2 ~ pin 2

component CapBoost:
    # 0603, X5R/X7R, 25 V rating. The rating is not optional: VGH sits near
    # +22 V and VGL near -20 V, and a 16 V part there dies.
    footprint = "Capacitor_SMD:C_0603_1608Metric"
    designator_prefix = "C"
    value = "?"
    signal p1 ~ pin 1
    signal p2 ~ pin 2


# --- top-edge controls -----------------------------------------------------
# Both of these are SIDE-actuated: the knob and the plunger come out of the
# end of the body, in the plane of the board, so they poke through the top
# edge of the case rather than through its front or back. That is the whole
# reason for these two particular parts -- an ordinary top-actuated slide
# switch or tact switch cannot reach a case edge at all.
# Both mount on the BACK of the board. See docs/top-edge.md.

component SlideSwitch:
    # Shouhan MSK-12C02, SPDT, side-actuated, 6.7 x 2.8 mm body with the knob
    # 1.45 mm proud of one end. LCSC C431540. Pin 2 is the common terminal.
    #
    # CHECK BEFORE ORDERING: KiCad places the three pads at x = -2.25, +0.75,
    # +2.25, which is an uneven 3.0 / 1.5 mm spacing and looks wrong for a
    # 1.5 mm-pitch part. The vendor drawing is behind a host this session
    # cannot reach, so it has not been confirmed. The netlist below is right
    # either way; it is the land pattern that wants a second look.
    #
    # The larger C&K JS102011SAQN is the nicer switch and has a clean 2.5 mm
    # pitch, but its courtyard is 8.75 mm deep and does not fit the 6 mm of
    # board above the panel. It becomes an option if the top bezel grows.
    footprint = "Button_Switch_SMD:SW_SPDT_Shouhan_MSK12C02"
    designator_prefix = "SW"
    value = "MSK-12C02 SPDT"
    signal a      ~ pin 1
    signal common ~ pin 2
    signal b      ~ pin 3
    signal shield ~ pin SH

component TactSwitchSide:
    # Alps SKRTLAE010, side-actuated SMD tact, 4.5 x 2.56 mm, plunger out the
    # end. Pads 1 and 2 are the contacts; MP are the mechanical anchors and
    # are not electrically part of the switch, so they go to ground for
    # strength and nothing else.
    footprint = "Button_Switch_SMD:SW_Push_1P1T-MP_NO_Horizontal_Alps_SKRTLAE010"
    designator_prefix = "SW"
    value = "SKRTLAE010"
    signal a  ~ pin 1
    signal b  ~ pin 2
    signal mp ~ pin MP

# --- MCU, display, sound ---------------------------------------------------

component ESP32S3MINI1:
    # ESP32-S3-MINI-1-N8: 8 MB flash, NO PSRAM.
    # The no-PSRAM part matters. Octal PSRAM would take IO33-IO37, which is
    # exactly where the panel interface lives below.
    #
    # PIN NUMBERS, and they are not guessed: they come from KiCad's own
    # ESP32-S3-MINI-1 symbol (RF_Module.kicad_symdir/ESP32-S3-MINI-1.kicad_sym).
    # That symbol also settles the footprint question -- KiCad's S3-MINI-1
    # symbol points at the S2-MINI-1 land pattern itself, because the MINI-1
    # module package is shared across the family. So this is what KiCad does,
    # not a substitution of mine.
    #
    # Note pins 23 and 24: the symbol calls them USB_D- and USB_D+ rather than
    # IO19 and IO20. Same pins, and the USB names are the honest ones here
    # since that is all we use them for.
    footprint = "RF_Module:ESP32-S2-MINI-1"
    designator_prefix = "U"
    value = "ESP32-S3-MINI-1-N8"
    signal V3P3 ~ pin 3
    signal EN   ~ pin 45
    signal IO0  ~ pin 4
    signal IO1  ~ pin 5
    signal IO2  ~ pin 6
    signal IO4  ~ pin 8
    signal IO5  ~ pin 9
    signal IO6  ~ pin 10
    signal IO7  ~ pin 11
    signal IO8  ~ pin 12
    signal IO9  ~ pin 13
    signal IO10 ~ pin 14
    signal IO11 ~ pin 15
    signal IO12 ~ pin 16
    signal IO13 ~ pin 17
    signal IO14 ~ pin 18
    signal IO15 ~ pin 19
    signal IO16 ~ pin 20
    signal IO17 ~ pin 21
    signal IO18 ~ pin 22
    signal IO21 ~ pin 25
    signal IO33 ~ pin 28
    signal IO34 ~ pin 29
    signal IO35 ~ pin 31
    signal IO36 ~ pin 32
    signal IO37 ~ pin 33
    signal IO38 ~ pin 34
    signal IO39 ~ pin 35
    signal IO40 ~ pin 36
    signal IO47 ~ pin 27
    signal IO48 ~ pin 30
    signal USB_DM ~ pin 23
    signal USB_DP ~ pin 24
    signal IO43 ~ pin 39
    signal IO44 ~ pin 40

    # 24 ground pads. Every one is tied in hp42s.ato; leaving the belly pads
    # floating on a module with a PCB antenna is not an option.
    signal GND1  ~ pin 1
    signal GND2  ~ pin 2
    signal GND42 ~ pin 42
    signal GND43 ~ pin 43
    signal GND46 ~ pin 46
    signal GND47 ~ pin 47
    signal GND48 ~ pin 48
    signal GND49 ~ pin 49
    signal GND50 ~ pin 50
    signal GND51 ~ pin 51
    signal GND52 ~ pin 52
    signal GND53 ~ pin 53
    signal GND54 ~ pin 54
    signal GND55 ~ pin 55
    signal GND56 ~ pin 56
    signal GND57 ~ pin 57
    signal GND58 ~ pin 58
    signal GND59 ~ pin 59
    signal GND60 ~ pin 60
    signal GND61 ~ pin 61
    signal GND62 ~ pin 62
    signal GND63 ~ pin 63
    signal GND64 ~ pin 64
    signal GND65 ~ pin 65

component EPDConnector:
    # 24-pin 0.5 mm FPC, bottom contact, for the Good Display GDEY0266T90.
    # The panel mounts on the FRONT of the board and the tail folds through a
    # slot to this connector on the BACK, so its height stays out of the
    # front stack-up.
    #
    # Pin NUMBERS here, from the panel specification (24.12.03) page 28.
    # This is the one part in the file where the numbering is certain, so it
    # is written down: the tail is a plain 24-way 0.5 mm flex and pad 1 of
    # the connector really is panel pin 1.
    #
    # Check the tail direction before ordering. FH12 is bottom-contact; if
    # the tail folds the other way you want a top-contact part instead, and
    # that is a different footprint with the same 24 pads.
    footprint = "Connector_FFC-FPC:Hirose_FH12-24S-0.5SH_1x24-1MP_P0.50mm_Horizontal"
    designator_prefix = "J"
    value = "GDEY0266T90 FPC"
    signal NC1   ~ pin 1
    signal GDR   ~ pin 2
    signal RESE  ~ pin 3
    signal NC4   ~ pin 4
    signal VSH2  ~ pin 5
    signal TSCL  ~ pin 6
    signal TSDA  ~ pin 7
    signal BS    ~ pin 8
    signal BUSY  ~ pin 9
    signal RES   ~ pin 10
    signal DC    ~ pin 11
    signal CS    ~ pin 12
    signal SCL   ~ pin 13
    signal SDA   ~ pin 14
    signal VDDIO ~ pin 15
    signal VCI   ~ pin 16
    signal VSS   ~ pin 17
    signal VDD   ~ pin 18
    signal VPP   ~ pin 19
    signal VSH1  ~ pin 20
    signal VGH   ~ pin 21
    signal VSL   ~ pin 22
    signal VGL   ~ pin 23
    signal VCOM  ~ pin 24

component StatusLED:
    # Side-emitting status indicator, on the top edge between USB-C and the
    # two recovery buttons. Dialight 599 series MicroLED, bi-colour, 1208
    # right angle, 3.0 x 2.0 x 1.0 mm, lens looking out of one long side.
    #
    # BI-COLOUR, NOT RGB. Two dice sharing a COMMON ANODE on pin 2, so the
    # two channels are driven LOW to light. Barnaby proposed the -0Q40-
    # (yellow + yellow-green); this is the -0Q70- (red + yellow-green),
    # because yellow against yellow-green is not a distinction anyone can
    # make through a diffused window. Red and green are, and the two
    # together read as amber, so two dice give three states.
    #
    # Red is LED die 1 on pin 3, yellow-green is LED die 2 on pin 1, per the
    # table on page 2 of the datasheet.
    #
    # There is no blue version of this that works here: the 599-0Q80's blue
    # die is specified up to 3.9 V forward, and the rail is 3.3 V. That is
    # also the reason not to chase a true RGB part -- every one of them has
    # the same InGaN blue die with the same problem. Two AlGaInP dice at 2.0
    # to 2.4 V are the right answer on a 3.3 V rail, not a compromise.
    #
    # Common anode does put a very weak pull-up on the two driving GPIOs
    # while they are high impedance at reset. That was a real objection when
    # this was three channels on an unverified part; it is not one now.
    # IO16 and IO39 are not strapping pins on the S3 -- only IO0, IO3, IO45
    # and IO46 are -- and the pull-up is through an unlit LED, so it is
    # leakage, not a divider.
    #
    # Land pattern from the recommended layout on page 1 of the datasheet,
    # generated by tools/gen_ic_footprints.py.
    footprint = "hp42s:Dialight_599_BiColor_1208_RA"
    designator_prefix = "D"
    value = "599-0Q70-247F red/green"
    signal ygreen ~ pin 1
    signal anode   ~ pin 2
    signal red   ~ pin 3

component Buzzer:
    footprint = "Buzzer_Beeper:Buzzer_Murata_PKLCS1212E"
    designator_prefix = "LS"
    value = "magnetic transducer"
    signal p ~ pin 1
    signal n ~ pin 2

component IRLED:
    # HP-82240 infrared printing, 940 nm.
    # SIDE-EMITTING, so the beam leaves through the top edge of the case the
    # way the original 42S's does. A top-emitting 0805 would fire straight up
    # into the back shell, which is what this was before.
    #
    # Vishay VSMB2943SLX01, confirmed side-looking from its own datasheet
    # (document 83479 rev 1.2): 2.3 x 2.55 x 2.3 mm, +/- 25 degrees half
    # angle, 20 mW/sr, 1.35 V typical at 100 mA. The land pattern is Vishay's
    # own IPC 7351 proposal, generated by tools/gen_ic_footprints.py -- two
    # 0.9 x 1.2 mm pads 4.2 mm across the outsides. It replaces the 1.6 x
    # 0.6 mm Kingbright pattern that was standing in for it, which was less
    # than half the size.
    #
    # The optical axis sits 1.2 mm above the face of the board it is soldered
    # to. The part is on the BACK, so the beam runs 1.2 mm behind the back
    # copper: that is where the window in the top edge of the case goes.
    #
    # The alternative, if range disappoints: a through-hole 3 mm IR LED lying
    # on its side with the leads bent, aimed at the top edge. Far more output
    # and a tighter beam, at the cost of one hand-fitted part and about 6 mm
    # of board depth. The HP-82240B is not fussy about either.
    #
    # Pad 1 is the cathode -- the left lead LOOKING INTO the lens, per the
    # front view on page 5 of the datasheet. Getting it backwards costs
    # nothing but a dark LED: 5 V reverse rating against our 3.3 V drive.
    footprint = "hp42s:Vishay_VSMB2943SLX01_SideView"
    designator_prefix = "D"
    value = "VSMB2943SLX01 940nm side-view"
    signal cathode ~ pin 1
    signal anode ~ pin 2
