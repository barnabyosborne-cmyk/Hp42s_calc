from "parts.ato" import BQ25185, TPS63900, MAX17048, USBCReceptacle, TPD4E05U06
from "parts.ato" import Battery, Resistor, Capacitor, Inductor, SlideSwitch

# ---------------------------------------------------------------------------
# power.ato -- USB-C in, linear charger with power path, buck-boost to 3V3.
#
#   VBUS --[BQ25185]-- SYS --[TPS63900]-- +3V3
#              |
#             BAT --[MAX17048 fuel gauge]
#
# The buck-boost is not optional. A single LiPo swings 4.2 V down to 3.0 V and
# the panel's VCI will not take 4.2 V, so a plain LDO would either burn the
# headroom at full charge or brown out the panel at the bottom of the
# discharge. The TPS63900's 75 nA quiescent current is also most of why the
# standing draw comes out at ~25 uA in deep sleep.
# ---------------------------------------------------------------------------

module Power:
    signal vbus
    signal bat
    signal sys
    signal v3v3
    signal gnd
    signal usb_dp
    signal usb_dm
    signal cc1
    signal cc2
    signal chg_stat
    signal chg_stat2
    signal i2c_sda
    signal i2c_scl
    signal reg_en

    # --- USB-C inlet ---------------------------------------------------------
    # On the TOP EDGE of the case, mouth flush with the board edge, mounted on
    # the BACK of the board. See docs/top-edge.md for why the back.
    #
    # Every contact is tied out by hand because the plug is reversible: the
    # four VBUS contacts and the four GND contacts are one net each, and D+/D-
    # appear twice. Miss one and the connector works in one orientation only,
    # which is the classic way to ship a cable that "sometimes" charges.
    usb = new USBCReceptacle
    usb.VBUS_A4 ~ vbus
    usb.VBUS_A9 ~ vbus
    usb.VBUS_B4 ~ vbus
    usb.VBUS_B9 ~ vbus
    usb.GND_A1  ~ gnd
    usb.GND_A12 ~ gnd
    usb.GND_B1  ~ gnd
    usb.GND_B12 ~ gnd
    usb.DP_A6 ~ usb_dp
    usb.DP_B6 ~ usb_dp
    usb.DM_A7 ~ usb_dm
    usb.DM_B7 ~ usb_dm
    usb.CC1 ~ cc1
    usb.CC2 ~ cc2
    usb.SHIELD ~ gnd
    # SBU1 / SBU2 (A8, B8) are left unconnected. They carry alternate-mode
    # signals we have no use for, and grounding them breaks audio adapters.

    # Two SEPARATE 5.1k pulldowns, one per CC line. A single shared resistor
    # is the classic USB-C mistake: it makes the sink look like a 10k Rd and
    # some sources will not enumerate it.
    r_cc1 = new Resistor
    r_cc1.value = "5.1k"
    r_cc1.p1 ~ cc1
    r_cc1.p2 ~ gnd

    r_cc2 = new Resistor
    r_cc2.value = "5.1k"
    r_cc2.p1 ~ cc2
    r_cc2.p2 ~ gnd

    esd = new TPD4E05U06
    esd.ch1 ~ usb_dp
    esd.ch2 ~ usb_dm
    esd.ch3 ~ cc1
    esd.ch4 ~ cc2
    esd.GND1 ~ gnd
    esd.GND2 ~ gnd

    c_vbus = new Capacitor
    c_vbus.value = "1u"
    c_vbus.footprint = "Capacitor_SMD:C_0603_1608Metric"
    c_vbus.p1 ~ vbus
    c_vbus.p2 ~ gnd

    # --- charger -------------------------------------------------------------
    chg = new BQ25185
    chg.IN ~ vbus
    chg.SYS ~ sys
    chg.BAT ~ bat
    chg.GND ~ gnd
    chg.PAD ~ gnd
    chg.CE_N ~ gnd          # charging always enabled
    chg.STAT1 ~ chg_stat
    chg.STAT2 ~ chg_stat2

    # ILIM/VSET is one pin doing two jobs. 18k sets the battery regulation
    # voltage to 4.2 V AND the input current limit to 500 mA -- TI's own
    # worked example, datasheet section 7.2.2.1. 500 mA is what any USB port
    # gives without negotiation, and nothing here reads the CC lines to ask
    # for more.
    r_ilim_vset = new Resistor
    r_ilim_vset.value = "18k 1%"
    r_ilim_vset.p1 ~ chg.ILIM_VSET
    r_ilim_vset.p2 ~ gnd

    # ISET sets fast charge current: ICHG = K_ISET / R_ISET, K_ISET = 300 AOhm.
    # 750 ohm gives 400 mA, deliberately BELOW the 500 mA input limit. If the
    # two were equal the input DPM loop would sit on its threshold and
    # regulate continuously the moment the calculator drew anything. 400 mA
    # is about 0.24 C on the 1650 mAh cell, so roughly four and a half hours
    # from flat, which is fine for something that charges overnight.
    r_iset = new Resistor
    r_iset.value = "750R 1%"
    r_iset.p1 ~ chg.ISET
    r_iset.p2 ~ gnd

    # TS/MR. This one is not optional and was missing: with the pin floating
    # the internal clamp holds it at VTS_CLAMP, the charger reads a
    # temperature fault and refuses to charge. The datasheet's instruction
    # for an unused TS is exactly this, 10k to ground (section 6.3.9.1).
    #
    # The better answer for a LiPo sealed inside a resin case is a real
    # 10k B3435 NTC taped to the cell in place of this resistor -- same two
    # pads, no layout change. Worth doing on the final board.
    r_ts = new Resistor
    r_ts.value = "10k"
    r_ts.p1 ~ chg.TS_MR
    r_ts.p2 ~ gnd

    # Both status pins are open-drain and need pulling up to be read.
    # STAT1/STAT2 together give four states: charging, done, recoverable
    # fault, latched fault.
    r_stat1_pu = new Resistor
    r_stat1_pu.value = "100k"
    r_stat1_pu.p1 ~ chg_stat
    r_stat1_pu.p2 ~ v3v3

    r_stat2_pu = new Resistor
    r_stat2_pu.value = "100k"
    r_stat2_pu.p1 ~ chg_stat2
    r_stat2_pu.p2 ~ v3v3

    cell = new Battery
    cell.p ~ bat
    cell.n ~ gnd

    c_bat = new Capacitor
    c_bat.value = "10u"
    c_bat.footprint = "Capacitor_SMD:C_0805_2012Metric"
    c_bat.p1 ~ bat
    c_bat.p2 ~ gnd

    c_sys = new Capacitor
    c_sys.value = "22u"
    c_sys.footprint = "Capacitor_SMD:C_0805_2012Metric"
    c_sys.p1 ~ sys
    c_sys.p2 ~ gnd

    # --- buck-boost ----------------------------------------------------------
    reg = new TPS63900
    reg.VIN ~ sys
    reg.VOUT ~ v3v3
    reg.EN ~ reg_en
    reg.GND ~ gnd
    reg.PAD ~ gnd

    # SEL low selects VO(1), which CFG3 sets. Tied hard to ground rather
    # than strapped: VO(2) is 3.6 V below, and 3.6 V on the panel's VCI is
    # at its absolute maximum. There is no version of this design where we
    # want SEL high, so do not leave it reachable.
    reg.SEL ~ gnd

    # The one fast node on the board besides the panel's booster. Keep this
    # loop under a few mm-squared and away from the panel's SPI.
    l_sw = new Inductor
    l_sw.value = "2.2u"
    l_sw.p1 ~ reg.LX1
    l_sw.p2 ~ reg.LX2

    # Output voltage is set by resistors, not a feedback divider -- this
    # part has no FB pin. All three CFG pins must be terminated; the
    # datasheet says none may be left open.
    #
    # CFG3 = 16.2k -> VO(1) = 3.3 V, which is what SEL low selects.
    # Datasheet table 7-3, and 1% is a requirement there, not a preference.
    r_cfg3 = new Resistor
    r_cfg3.value = "16.2k 1%"
    r_cfg3.p1 ~ reg.CFG3
    r_cfg3.p2 ~ gnd

    # CFG1 and CFG2 set VO(2) and the input current limit. We never select
    # VO(2), but the pins still have to be defined, so: 1.15k puts VO(2) at
    # its lowest setting and 8.25k sets the input current limit to
    # unlimited, which is the setting that cannot surprise us whichever
    # configuration the part reads. Datasheet table 7-2.
    r_cfg1 = new Resistor
    r_cfg1.value = "1.15k 1%"
    r_cfg1.p1 ~ reg.CFG1
    r_cfg1.p2 ~ gnd

    r_cfg2 = new Resistor
    r_cfg2.value = "8.25k 1%"
    r_cfg2.p1 ~ reg.CFG2
    r_cfg2.p2 ~ gnd

    c_out = new Capacitor
    c_out.value = "22u"
    c_out.footprint = "Capacitor_SMD:C_0805_2012Metric"
    c_out.p1 ~ v3v3
    c_out.p2 ~ gnd

    c_out_hf = new Capacitor
    c_out_hf.value = "100n"
    c_out_hf.p1 ~ v3v3
    c_out_hf.p2 ~ gnd

    # --- fuel gauge ----------------------------------------------------------
    gauge = new MAX17048
    # VDD on the CELL, not on 3V3. The power slider now cuts the 3.3 V rail,
    # and a ModelGauge part that loses power loses the model it has learned --
    # come back to the calculator after a month in a drawer and the charge
    # reading would be guesswork for the first few cycles. Off the cell it
    # keeps counting, at about 4 uA in hibernate.
    # CHECK BEFORE FAB: its SDA/SCL then sit on a 4.2 V part with 3.3 V
    # pull-ups. The MAX17048 input thresholds are fixed rather than
    # VDD-referenced, so this should be fine, but read the DC table.
    gauge.VDD ~ bat
    gauge.SDA ~ i2c_sda
    gauge.SCL ~ i2c_scl
    gauge.GND ~ gnd
    gauge.CTG ~ gnd         # datasheet: "connect to ground"
    gauge.QSTRT ~ gnd       # datasheet: "connect to GND if not used"
    gauge.PAD ~ gnd
    # CELL is left unconnected on purpose. On the MAX17048 it is not
    # internally connected at all -- VDD is the sense input. It is the
    # 2-cell MAX17049 that uses CELL, and wiring this board as if it were
    # one would read a battery that is not there.
    #
    # ALRT_N is left unconnected. Bring it to a spare GPIO only if you want
    # low-battery interrupts rather than polling.

    c_gauge = new Capacitor
    c_gauge.value = "100n"
    c_gauge.p1 ~ bat
    c_gauge.p2 ~ gnd

    # --- power slider --------------------------------------------------------
    # The slider does NOT carry the load. It sets the buck-boost's enable pin
    # and nothing else, so it switches microamps: no arcing, no contact
    # resistance in the supply path, and a 2.8 mm switch is plenty.
    #
    # SPDT with both throws driven, rather than one throw and a pull-up. EN
    # then sits hard at SYS or hard at ground and is never floating, which
    # matters because a floating enable on a buck-boost is how you get a
    # regulator that hums at the halfway point of the slider's travel.
    #
    # (This also fixes a real bug: EN used to be tied to the regulator's own
    # 3.3 V output, which is a rail that cannot exist until EN is already
    # high. As drawn before, it could never have started.)
    #
    # Charging is deliberately upstream of this. With the slider off, USB
    # still charges the cell and the fuel gauge still counts.
    sw_power = new SlideSwitch
    sw_power.common ~ reg_en
    sw_power.a ~ sys
    sw_power.b ~ gnd
    sw_power.shield ~ gnd

    r_sda = new Resistor
    r_sda.value = "4.7k"
    r_sda.p1 ~ i2c_sda
    r_sda.p2 ~ v3v3

    r_scl = new Resistor
    r_scl.value = "4.7k"
    r_scl.p1 ~ i2c_scl
    r_scl.p2 ~ v3v3
