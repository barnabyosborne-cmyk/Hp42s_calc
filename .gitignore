# atopile
build/
.ato/
*.lock

# KiCad
*-backups/
*.kicad_pcb-bak
*.kicad_sch-bak
*.kicad_prl
fp-info-cache
~*.*
*.net.bak

# Editor local history. VS Code's "Local History" extension and several
# others drop a .history/ folder beside the files they are watching, and
# some of them run `git init` inside it. An uninitialised nested repo makes
# `git add -A` fail outright with "does not have a commit checked out".
.history/

# Python
__pycache__/
*.pyc
.venv/
venv/

# OS
.DS_Store
Thumbs.db

# ESP-IDF
firmware/sdkconfig
firmware/sdkconfig.old
firmware/dependencies.lock

# Intel decimal library, laid out by firmware/vendor/setup.sh
firmware/components/libbid/src/
firmware/components/libbid/float128/

# Autorouter. The .dsn is the input and is committed -- a routing run is
# reproducible from it. The .ses is an output, and a big one, and the log is
# per-run.
*.ses
*.autoroute.log
